<Window x:Class="ConSecOrg.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ConSecOrg.Client.ViewModels"
        xmlns:startup="clr-namespace:ConSecOrg.Client.ViewModels.Startup"
        xmlns:shell="clr-namespace:ConSecOrg.Client.ViewModels.Shell"
        xmlns:startupViews="clr-namespace:ConSecOrg.Client.Views.Startup"
        xmlns:shellViews="clr-namespace:ConSecOrg.Client.Views.Shell"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="ConSecOrg — Защищённый органайзер"
        Icon="Assets/Icons/app.ico"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackground}"
        Closing="Window_Closing">

    <Window.Resources>
        <DataTemplate DataType="{x:Type startup:ModeSelectionViewModel}">
            <startupViews:ModeSelectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type startup:LoginViewModel}">
            <startupViews:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type startup:PinViewModel}">
            <startupViews:PinView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type startup:RegisterViewModel}">
            <startupViews:RegisterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type shell:ShellViewModel}">
            <shellViews:ShellView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- System tray icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/Icons/app.ico"
                        ToolTipText="ConSecOrg — Защищённый органайзер"
                        TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Открыть" Click="TrayMenu_Open"/>
                    <MenuItem Header="Заблокировать сессию" Click="TrayMenu_Lock"/>
                    <Separator/>
                    <MenuItem Header="Выход" Click="TrayMenu_Exit"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <ContentControl Content="{Binding CurrentView}"
                        Focusable="False"/>

        <!-- Toast notifications overlay — bottom right corner -->
        <ItemsControl x:Name="ToastOverlay"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Margin="0,0,24,24"
                      IsHitTestVisible="False"/>
    </Grid>
</Window>
