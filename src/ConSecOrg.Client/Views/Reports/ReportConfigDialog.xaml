<Window x:Class="ConSecOrg.Client.Views.Reports.ReportConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ConSecOrg.Client.ViewModels.Reports"
        Title="Настроить отчёт"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SecondaryBackground}">

    <Window.Resources>
        <ResourceDictionary Source="/Themes/Generic.xaml"/>
    </Window.Resources>

    <StackPanel Margin="24,20,24,24">
        <TextBlock Text="Параметры отчёта" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,20"/>

        <!-- Date range -->
        <TextBlock Text="Период" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DatePicker Grid.Column="0"
                        SelectedDate="{Binding DateFrom}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        md:HintAssist.Hint="С даты"
                        md:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                        Foreground="{DynamicResource PrimaryForeground}"/>
            <DatePicker Grid.Column="2"
                        SelectedDate="{Binding DateTo}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        md:HintAssist.Hint="По дату"
                        md:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                        Foreground="{DynamicResource PrimaryForeground}"/>
        </Grid>

        <!-- Show options -->
        <TextBlock Text="Показывать" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource SecondaryForeground}" Margin="0,16,0,8"/>
        <StackPanel Orientation="Horizontal">
            <CheckBox IsChecked="{Binding ShowOpen}" Content="Открытые задачи"
                      Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,20,0"/>
            <CheckBox IsChecked="{Binding ShowCompleted}" Content="Выполненные"
                      Foreground="{DynamicResource PrimaryForeground}"/>
        </StackPanel>

        <!-- Grouping -->
        <TextBlock Text="Группировка" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource SecondaryForeground}" Margin="0,16,0,8"/>
        <CheckBox IsChecked="{Binding GroupByProject}" Content="Группировать по проектам"
                  Foreground="{DynamicResource PrimaryForeground}"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Применить"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    md:ButtonAssist.CornerRadius="6"
                    IsDefault="True"
                    Click="Apply_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Отмена"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    md:ButtonAssist.CornerRadius="6"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
