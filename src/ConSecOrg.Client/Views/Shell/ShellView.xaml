<UserControl x:Class="ConSecOrg.Client.Views.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ctrl="clr-namespace:ConSecOrg.Client.Controls"
             xmlns:notesVm="clr-namespace:ConSecOrg.Client.ViewModels.Notes"
             xmlns:tasksVm="clr-namespace:ConSecOrg.Client.ViewModels.Tasks"
             xmlns:calVm="clr-namespace:ConSecOrg.Client.ViewModels.Calendar"
             xmlns:contactsVm="clr-namespace:ConSecOrg.Client.ViewModels.Contacts"
             xmlns:dashVm="clr-namespace:ConSecOrg.Client.ViewModels.Dashboard"
             xmlns:auditVm="clr-namespace:ConSecOrg.Client.ViewModels.Audit"
             xmlns:reportsVm="clr-namespace:ConSecOrg.Client.ViewModels.Reports"
             xmlns:companyVm="clr-namespace:ConSecOrg.Client.ViewModels.Company"
             xmlns:usersVm="clr-namespace:ConSecOrg.Client.ViewModels.Users"
             xmlns:settingsVm="clr-namespace:ConSecOrg.Client.ViewModels.Settings"
             xmlns:svc="clr-namespace:ConSecOrg.Client.Services"
             xmlns:notesViews="clr-namespace:ConSecOrg.Client.Views.Notes"
             xmlns:tasksViews="clr-namespace:ConSecOrg.Client.Views.Tasks"
             xmlns:calViews="clr-namespace:ConSecOrg.Client.Views.Calendar"
             xmlns:contactsViews="clr-namespace:ConSecOrg.Client.Views.Contacts"
             xmlns:dashViews="clr-namespace:ConSecOrg.Client.Views.Dashboard"
             xmlns:auditViews="clr-namespace:ConSecOrg.Client.Views.Audit"
             xmlns:reportsViews="clr-namespace:ConSecOrg.Client.Views.Reports"
             xmlns:companyViews="clr-namespace:ConSecOrg.Client.Views.Company"
             xmlns:usersViews="clr-namespace:ConSecOrg.Client.Views.Users"
             xmlns:settingsViews="clr-namespace:ConSecOrg.Client.Views.Settings"
             xmlns:chatsVm="clr-namespace:ConSecOrg.Client.ViewModels.Chats"
             xmlns:chatsViews="clr-namespace:ConSecOrg.Client.Views.Chats"
             xmlns:chatViews="clr-namespace:ConSecOrg.Client.Views.Tasks"
             xmlns:shellVm="clr-namespace:ConSecOrg.Client.ViewModels.Shell"
             xmlns:dto="clr-namespace:ConSecOrg.Shared.DTOs.Projects;assembly=ConSecOrg.Shared">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type notesVm:NotesListViewModel}">
            <notesViews:NotesListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type notesVm:NoteEditorViewModel}">
            <notesViews:NoteEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type tasksVm:KanbanBoardViewModel}">
            <tasksViews:KanbanBoardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type tasksVm:MyTasksViewModel}">
            <tasksViews:MyTasksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type calVm:CalendarViewModel}">
            <calViews:CalendarView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type contactsVm:ContactsViewModel}">
            <contactsViews:ContactsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dashVm:SecurityDashboardViewModel}">
            <dashViews:SecurityDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type auditVm:AuditLogViewModel}">
            <auditViews:AuditLogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
            <settingsViews:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type reportsVm:ReportsViewModel}">
            <reportsViews:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type companyVm:CompanyViewModel}">
            <companyViews:CompanyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type companyVm:SharedProjectBoardViewModel}">
            <companyViews:SharedProjectBoardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type usersVm:UsersManagementViewModel}">
            <usersViews:UsersManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type chatsVm:ChatsViewModel}">
            <chatsViews:ChatsView/>
        </DataTemplate>

        <!-- Section nav styles -->
        <Style x:Key="NavNotes" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="notes">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavTasks" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="tasks">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavMyTasks" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="mytasks">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavCalendar" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="calendar">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavContacts" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="contacts">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavDashboard" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="dashboard">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavAudit" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="audit">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavSettings" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="settings">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavReports" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="reports">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavCompany" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="company">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavUsers" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="users">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavChats" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="chats">
                    <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Root with optional background image layers -->
    <Grid>
        <Rectangle Fill="{DynamicResource AppBackgroundBrush}" Stretch="UniformToFill"/>
        <Rectangle Fill="{DynamicResource AppOverlayBrush}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ SIDEBAR (YouGile style) ═══ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Width="248">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Logo -->
                        <RowDefinition Height="*"/>     <!-- Nav + projects -->
                        <RowDefinition Height="Auto"/>  <!-- User footer -->
                    </Grid.RowDefinitions>

                    <!-- ─── Logo ─── -->
                    <Border Grid.Row="0" Padding="16,16,16,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10"
                                    Background="{DynamicResource AccentBrush}">
                                <materialDesign:PackIcon Kind="ShieldLock"
                                                         Width="22" Height="22"
                                                         Foreground="White"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ConSecOrg"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource SecondaryForeground}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Персональный"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCorporate}" Value="True">
                                                    <Setter Property="Text" Value="Корпоративный"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── Nav scroll area ─── -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">

                            <!-- Section: Main nav -->
                            <TextBlock Text="ГЛАВНОЕ"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Margin="16,4,16,6"
                                       Opacity="0.6"/>

                            <Button Command="{Binding NavigateNotesCommand}" Style="{StaticResource NavNotes}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="NoteText" Width="17" Height="17"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Заметки" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateMyTasksCommand}" Style="{StaticResource NavMyTasks}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountCheck" Width="17" Height="17"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Мои задачи" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCalendarCommand}" Style="{StaticResource NavCalendar}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalendarMonth" Width="17" Height="17"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Календарь" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Contacts (corporate only) -->
                            <Button Command="{Binding NavigateContactsCommand}" Style="{StaticResource NavContacts}"
                                    Visibility="{Binding IsCorporate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountGroup" Width="17" Height="17"
                                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Контакты" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Pending requests badge -->
                                    <Border Background="#EF5350" CornerRadius="8"
                                            MinWidth="16" Height="16" Padding="3,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0"
                                            Visibility="{Binding HasPendingContacts, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding PendingContactsCount}"
                                                   FontSize="9" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Чаты (corporate only) -->
                            <Button Command="{Binding NavigateChatsCommand}" Style="{StaticResource NavChats}"
                                    Visibility="{Binding IsCorporate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MessageOutline" Width="17" Height="17"
                                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Чаты" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Unread badge -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-4,-4,0"
                                            Background="#EF5350" CornerRadius="8" MinWidth="16" Height="16"
                                            Padding="3,0"
                                            Visibility="{Binding HasUnreadChats, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding UnreadChatsCount}"
                                                   Foreground="White" FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- ─── ПРОЕКТЫ section ─── -->
                            <Border Margin="0,10,0,0">
                                <StackPanel>
                                    <!-- Section header: ПРОЕКТЫ + collapse + create -->
                                    <Grid Margin="10,0,6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Command="{Binding ToggleProjectsCommand}"
                                                Style="{StaticResource FlatIconButton}"
                                                HorizontalAlignment="Left"
                                                Padding="6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="10" Height="10"
                                                                         Margin="0,0,6,0"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource SecondaryForeground}"
                                                                         Opacity="0.6">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="ChevronDown"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProjectsExpanded}" Value="False">
                                                                    <Setter Property="Kind" Value="ChevronRight"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <TextBlock Text="ПРОЕКТЫ"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryForeground}"
                                                           Opacity="0.6" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- "Все задачи" shortcut -->
                                        <Button Grid.Column="1"
                                                Command="{Binding NavigateTasksCommand}"
                                                Style="{StaticResource FlatIconButton}"
                                                ToolTip="Все задачи" Width="28" Height="28">
                                            <materialDesign:PackIcon Kind="ViewColumn" Width="14" Height="14"
                                                                     Foreground="{DynamicResource SecondaryForeground}"/>
                                        </Button>

                                        <!-- Create project -->
                                        <Button Grid.Column="2"
                                                Command="{Binding CreateProjectFromSidebarCommand}"
                                                Style="{StaticResource FlatIconButton}"
                                                ToolTip="Создать проект" Width="28" Height="28">
                                            <materialDesign:PackIcon Kind="FolderPlus" Width="14" Height="14"
                                                                     Foreground="{DynamicResource AccentBrush}"/>
                                        </Button>
                                    </Grid>

                                    <!-- Inline project creation form -->
                                    <Border Padding="8,4"
                                            Visibility="{Binding ShowInlineProjectCreate, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding NewProjectNameInline, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Название проекта"
                                                     materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                                     materialDesign:HintAssist.IsFloating="False"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Foreground="{DynamicResource PrimaryForeground}"
                                                     CaretBrush="{DynamicResource PrimaryForeground}"
                                                     FontSize="12" Height="40" Padding="10,8"
                                                     VerticalContentAlignment="Center">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ConfirmCreateProjectCommand}"/>
                                                    <KeyBinding Key="Escape" Command="{Binding CancelCreateProjectCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button Grid.Column="1" Style="{StaticResource FlatIconButton}"
                                                    Width="28" Height="28" Margin="2,0"
                                                    Command="{Binding ConfirmCreateProjectCommand}"
                                                    ToolTip="Создать">
                                                <materialDesign:PackIcon Kind="Check" Width="14" Height="14"
                                                                         Foreground="{DynamicResource AccentBrush}"/>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource FlatIconButton}"
                                                    Width="28" Height="28"
                                                    Command="{Binding CancelCreateProjectCommand}"
                                                    ToolTip="Отмена">
                                                <materialDesign:PackIcon Kind="Close" Width="13" Height="13"
                                                                         Foreground="{DynamicResource SecondaryForeground}"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Project list (collapsed when IsProjectsExpanded = false) -->
                                    <ItemsControl ItemsSource="{Binding Projects}"
                                                  Visibility="{Binding IsProjectsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type svc:ProjectItem}">
                                                <StackPanel>
                                                    <!-- Project row -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0"
                                                                Command="{Binding DataContext.NavigateProjectCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ProjectSidebarButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource EqualityMultiConverter}">
                                                                                    <Binding Path="Id"/>
                                                                                    <Binding Path="DataContext.SelectedProjectId"
                                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="8" Height="8"
                                                                         Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                                                         Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="130"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- Delete project button -->
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource FlatIconButton}"
                                                                Width="26" Height="26" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.DeleteProjectCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Удалить проект">
                                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13"
                                                                                     Foreground="#EF5350" Opacity="0.7"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Boards sub-list -->
                                                    <ItemsControl ItemsSource="{Binding Boards}"
                                                                  Margin="0,0,0,2">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type svc:BoardItem}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0"
                                                                            Command="{Binding DataContext.NavigateBoardCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource BoardSidebarButton}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <materialDesign:PackIcon Kind="ViewDashboard"
                                                                                                     Width="12" Height="12"
                                                                                                     Margin="0,0,7,0"
                                                                                                     VerticalAlignment="Center"
                                                                                                     Foreground="{DynamicResource SecondaryForeground}"/>
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       MaxWidth="110"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <!-- Delete board button -->
                                                                    <Button Grid.Column="1"
                                                                            Style="{StaticResource FlatIconButton}"
                                                                            Width="22" Height="22" Margin="0,0,4,0"
                                                                            Command="{Binding DataContext.DeleteBoardCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Удалить доску">
                                                                        <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                                                 Width="11" Height="11"
                                                                                                 Foreground="#EF5350" Opacity="0.6"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Placeholder when no projects -->
                                    <TextBlock Text="Нет проектов"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryForeground}"
                                               Margin="16,6,0,0" Opacity="0.5"
                                               Visibility="{Binding IsProjectsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Border>

                            <!-- ─── СОВМЕСТНЫЕ ПРОЕКТЫ section ─── -->
                            <Border Padding="0,4,0,4"
                                    Visibility="{Binding IsCorporate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Section header -->
                                    <Grid Margin="8,0,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Command="{Binding ToggleSharedProjectsCommand}"
                                                Style="{StaticResource FlatIconButton}"
                                                HorizontalContentAlignment="Left"
                                                Padding="6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="10" Height="10"
                                                                         Margin="0,0,6,0" VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource SecondaryForeground}"
                                                                         Opacity="0.6">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="ChevronDown"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSharedProjectsExpanded}" Value="False">
                                                                    <Setter Property="Kind" Value="ChevronRight"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <TextBlock Text="СОВМЕСТНЫЕ"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryForeground}"
                                                           Opacity="0.6" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Go to Моя компания -->
                                        <Button Grid.Column="1"
                                                Command="{Binding NavigateCompanyCommand}"
                                                Style="{StaticResource FlatIconButton}"
                                                ToolTip="Моя компания" Width="28" Height="28">
                                            <materialDesign:PackIcon Kind="Domain" Width="14" Height="14"
                                                                     Foreground="{DynamicResource AccentBrush}"/>
                                        </Button>
                                    </Grid>

                                    <!-- Shared projects list -->
                                    <ItemsControl ItemsSource="{Binding SharedProjects}"
                                                  Visibility="{Binding IsSharedProjectsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type dto:SharedProjectDto}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Navigate to board -->
                                                    <Button Grid.Column="0"
                                                            Command="{Binding DataContext.NavigateSharedProjectCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ProjectSidebarButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource EqualityMultiConverter}">
                                                                                <Binding Path="Id"/>
                                                                                <Binding Path="DataContext.SelectedSharedProjectId"
                                                                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource NavActiveForeground}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="AccountMultiple"
                                                                                     Width="10" Height="10"
                                                                                     Foreground="{DynamicResource AccentBrush}"
                                                                                     Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="120"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- Chat button -->
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource FlatIconButton}"
                                                            Width="26" Height="26" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.OpenProjectChatCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Открыть чат">
                                                        <materialDesign:PackIcon Kind="Chat" Width="13" Height="13"
                                                                                 Foreground="{DynamicResource AccentBrush}" Opacity="0.8"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty hint -->
                                    <TextBlock Text="Нет совместных проектов"
                                               FontSize="11" Margin="16,4,0,0" Opacity="0.45"
                                               Foreground="{DynamicResource SecondaryForeground}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SharedProjects.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ─── Divider ─── -->
                            <Border Margin="16,10" Height="1" Background="{DynamicResource BorderBrush}"/>

                            <!-- ─── Reports (corporate) ─── -->
                            <Button Command="{Binding NavigateReportsCommand}" Style="{StaticResource NavReports}"
                                    Visibility="{Binding CanSeeReports, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartBar" Width="17" Height="17"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Отчёты" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- ─── Corporate-only section (Admin/Auditor only) ─── -->
                            <TextBlock Text="БЕЗОПАСНОСТЬ"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Margin="16,6,16,6" Opacity="0.6"
                                       Visibility="{Binding IsAdminOrAuditor, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Button Command="{Binding NavigateDashboardCommand}" Style="{StaticResource NavDashboard}"
                                    Visibility="{Binding IsAdminOrAuditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldCheck" Width="17" Height="17"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Безопасность" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateAuditCommand}" Style="{StaticResource NavAudit}"
                                    Visibility="{Binding IsAdminOrAuditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardList" Width="17" Height="17"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Аудит" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Моя компания (corporate users) -->
                            <Button Command="{Binding NavigateCompanyCommand}" Style="{StaticResource NavCompany}"
                                    Visibility="{Binding CanSeeCompany, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Domain" Width="17" Height="17"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Моя компания" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Пользователи (admin only) -->
                            <Button Command="{Binding NavigateUsersCommand}" Style="{StaticResource NavUsers}"
                                    Visibility="{Binding CanSeeUsers, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountMultiple" Width="17" Height="17"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Пользователи" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Margin="16,10" Height="1" Background="{DynamicResource BorderBrush}"
                                    Visibility="{Binding IsCorporate, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Settings -->
                            <Button Command="{Binding NavigateSettingsCommand}" Style="{StaticResource NavSettings}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cog" Width="17" Height="17"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─── User footer ─── -->
                    <Border Grid.Row="2" Padding="12,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar: image when set, else first-letter circle -->
                            <Grid Width="34" Height="34">
                                <Border Width="34" Height="34" CornerRadius="17"
                                        Background="{DynamicResource AccentBrush}"
                                        Visibility="{Binding SidebarHasAvatar, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SidebarDisplayName,
                                               Converter={StaticResource FirstLetterConverter},
                                               FallbackValue='?', TargetNullValue='?'}"
                                               Foreground="White"
                                               FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="34" Height="34" CornerRadius="17"
                                        ClipToBounds="True"
                                        Visibility="{Binding SidebarHasAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Image Source="{Binding SidebarAvatarPath, Converter={StaticResource ImagePathConverter}}"
                                           Stretch="UniformToFill"/>
                                </Border>
                            </Grid>

                            <!-- DisplayName + mode -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SidebarDisplayName, FallbackValue='—'}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryForeground}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource SecondaryForeground}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Персональный"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCorporate}" Value="True">
                                                    <Setter Property="Text" Value="Корпоративный"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Logout -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource FlatIconButton}"
                                    Command="{Binding LogoutCommand}"
                                    ToolTip="Выйти">
                                <materialDesign:PackIcon Kind="Logout" Width="18" Height="18"
                                                         Foreground="{DynamicResource SecondaryForeground}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ MAIN CONTENT ═══ -->
            <Grid Grid.Column="1">
                <ctrl:TransitionContentControl Content="{Binding CurrentPage}" Focusable="False"/>
                <!-- Simple local chat panel overlay (project boards) -->
                <chatViews:ChatPanelView DataContext="{Binding ChatPanel}"
                                         HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                         Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <!-- Shared/API chat panel overlay — available globally from any page -->
                <companyViews:SharedChatPanelView DataContext="{Binding SharedChatPanel}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                                   Width="380"/>

                <!-- Floating chat FAB (corporate, bottom-right) -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,20,20"
                        Command="{Binding OpenChatFabCommand}"
                        Style="{StaticResource AppRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="28"
                        Width="52" Height="52" Padding="0"
                        ToolTip="Чаты"
                        Visibility="{Binding ShowFloatingChatButton, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <materialDesign:PackIcon Kind="MessageTextOutline" Width="22" Height="22"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Unread badge on FAB -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-4,0"
                                Background="#EF5350" CornerRadius="8" MinWidth="16" Height="16"
                                Padding="3,0"
                                Visibility="{Binding HasUnreadChats, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding UnreadChatsCount}"
                                       Foreground="White" FontSize="8" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
