<UserControl x:Class="ConSecOrg.Client.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackground}"
             TextElement.Foreground="{DynamicResource PrimaryForeground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </Border>

        <!-- Tab content -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                    <Setter Property="Padding" Value="24,12"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
            </TabControl.Resources>

            <!-- ══════════════════════════════════════════════════════════
                 TAB 1 — Внешний вид (Appearance)
            ══════════════════════════════════════════════════════════ -->
            <TabItem Header="Внешний вид">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,24" MaxWidth="720" HorizontalAlignment="Left">

                        <!-- ── Цветовая схема ── -->
                        <Border Style="{StaticResource AppCard}">
                            <StackPanel>
                                <TextBlock Text="Цветовая схема"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForeground}"
                                           Margin="0,0,0,16"/>

                                <!-- Theme toggle (like YouGile) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <!-- Dark -->
                                    <Border CornerRadius="10" Margin="0,0,12,0"
                                            Cursor="Hand" Width="110" Height="80">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding SetThemeCommand}"
                                                          CommandParameter="Dark"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTheme}" Value="Dark">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    Background="#1E1F2E" HorizontalAlignment="Center"
                                                    Margin="0,0,0,6">
                                                <materialDesign:PackIcon Kind="WeatherNight" Width="22" Height="22"
                                                                         Foreground="#EDEFF8"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Тёмная"
                                                       FontSize="12" FontWeight="Medium"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForeground}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Light -->
                                    <Border CornerRadius="10" Cursor="Hand" Width="110" Height="80">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding SetThemeCommand}"
                                                          CommandParameter="Light"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTheme}" Value="Light">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    Background="#F4F5FB" HorizontalAlignment="Center"
                                                    Margin="0,0,0,6">
                                                <materialDesign:PackIcon Kind="WeatherSunny" Width="22" Height="22"
                                                                         Foreground="#FF9800"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Светлая"
                                                       FontSize="12" FontWeight="Medium"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForeground}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Font size slider -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="{Binding FontSize, StringFormat='Размер шрифта: {0}px'}"
                                               FontSize="13" Foreground="{DynamicResource PrimaryForeground}"
                                               VerticalAlignment="Center" Width="200"/>
                                    <Slider Value="{Binding FontSize}"
                                            Minimum="11" Maximum="20"
                                            Width="200" TickFrequency="1"
                                            IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Акцентный цвет ── -->
                        <Border Style="{StaticResource AppCard}">
                            <StackPanel>
                                <TextBlock Text="Акцентный цвет"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForeground}"
                                           Margin="0,0,0,12"/>

                                <ItemsControl ItemsSource="{Binding MaterialAccents}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="34" Height="34" Margin="4" Cursor="Hand"
                                                    Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    BorderThickness="0" ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Swatch" CornerRadius="6"
                                                                Width="34" Height="34">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding}"/>
                                                            </Border.Background>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Swatch" Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Custom HEX + preview -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBox Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="#RRGGBB"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Width="160" Margin="0,0,10,0" FontFamily="Consolas"/>
                                    <Border Width="38" Height="38" CornerRadius="6" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            Background="{DynamicResource AccentBrush}"/>
                                    <Button Style="{StaticResource AppRaisedButton}"
                                            Command="{Binding ApplyThemeCommand}"
                                            materialDesign:ButtonAssist.CornerRadius="8"
                                            Margin="10,0,0,0" Height="36" VerticalAlignment="Center">
                                        <TextBlock Text="Применить" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Цвет текста кнопок ── -->
                        <Border Style="{StaticResource AppCard}">
                            <StackPanel>
                                <TextBlock Text="Цвет текста кнопок"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForeground}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Применяется ко всем основным (акцентным) кнопкам приложения."
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForeground}"
                                           Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <!-- Preview -->
                                <Border Background="{DynamicResource AccentBrush}"
                                        CornerRadius="8" Width="140" Height="38"
                                        HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <TextBlock Text="Применить"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource ButtonForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Preset pills -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <!-- Авто -->
                                    <Button Command="{Binding SetButtonForegroundCommand}"
                                            CommandParameter="auto"
                                            Height="32" Margin="0,0,8,0"
                                            materialDesign:ButtonAssist.CornerRadius="16">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsButtonForegroundAuto}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AutoFix" Width="14" Height="14" Margin="0,0,4,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource PrimaryForeground}"/>
                                            <TextBlock Text="Авто" FontSize="12"
                                                       Foreground="{DynamicResource PrimaryForeground}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Белый -->
                                    <Button Command="{Binding SetButtonForegroundCommand}"
                                            CommandParameter="white"
                                            Height="32" Margin="0,0,8,0"
                                            materialDesign:ButtonAssist.CornerRadius="16">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsButtonForegroundWhite}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" CornerRadius="7"
                                                    Background="White" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Белый" FontSize="12"
                                                       Foreground="{DynamicResource PrimaryForeground}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Чёрный -->
                                    <Button Command="{Binding SetButtonForegroundCommand}"
                                            CommandParameter="black"
                                            Height="32"
                                            materialDesign:ButtonAssist.CornerRadius="16">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsButtonForegroundBlack}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentAlpha2Brush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" CornerRadius="7"
                                                    Background="#1A1C30" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Чёрный" FontSize="12"
                                                       Foreground="{DynamicResource PrimaryForeground}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Custom HEX -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding ButtonForegroundHex, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="#RRGGBB"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Width="160" Margin="0,0,10,0" FontFamily="Consolas"
                                             Foreground="{DynamicResource PrimaryForeground}"/>
                                    <!-- Live preview swatch -->
                                    <Border Width="38" Height="38" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="A" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource ButtonForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding ApplyButtonForegroundCommand}"
                                            materialDesign:ButtonAssist.CornerRadius="8"
                                            Height="36" VerticalAlignment="Center">
                                        <TextBlock Text="Применить" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryForeground}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Фоновое изображение ── -->
                        <Border Style="{StaticResource AppCard}">
                            <StackPanel>
                                <TextBlock Text="Фоновое изображение доски"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForeground}"
                                           Margin="0,0,0,12"/>

                                <Border Height="120" CornerRadius="8"
                                        Background="{DynamicResource NavActiveBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" Margin="0,0,0,12" ClipToBounds="True">
                                    <Grid>
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding BackgroundImagePath, Converter={StaticResource ImagePathConverter}}"
                                               Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding HasBackground, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="ImageOutline" Width="36" Height="36"
                                                                     Foreground="{DynamicResource BorderBrush}"
                                                                     HorizontalAlignment="Center"/>
                                            <TextBlock Text="Фон не установлен" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryForeground}"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding BrowseBackgroundCommand}"
                                            materialDesign:ButtonAssist.CornerRadius="8"
                                            Height="36" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderImage" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="+ Загрузить свой фон" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding ClearBackgroundCommand}"
                                            materialDesign:ButtonAssist.CornerRadius="8"
                                            Height="36"
                                            Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Убрать фон" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding BackgroundOverlayOpacity, StringFormat='Затемнение: {0:P0}'}"
                                               FontSize="12" Foreground="{DynamicResource SecondaryForeground}"
                                               Margin="0,0,0,4"/>
                                    <Slider Value="{Binding BackgroundOverlayOpacity}"
                                            Minimum="0.3" Maximum="1.0"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Width="300" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Интерфейс ── -->
                        <Border Style="{StaticResource AppCard}"
                                Visibility="{Binding IsCorporate, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Интерфейс"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForeground}"
                                           Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton IsChecked="{Binding ShowFloatingChatButton}"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock Text="Плавающая кнопка чата (нижний правый угол)"
                                               FontSize="13" Foreground="{DynamicResource PrimaryForeground}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════
                 TAB 2 — Профиль и аккаунт (like YouGile profile screen)
            ══════════════════════════════════════════════════════════ -->
            <TabItem Header="Профиль и аккаунт">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,24" MaxWidth="720" HorizontalAlignment="Left">

                        <!-- Two-column layout -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Profile card -->
                            <Border Grid.Column="0" Style="{StaticResource AppCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Профиль"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForeground}"/>
                                        <Button HorizontalAlignment="Right"
                                                Command="{Binding LogoutCommand}"
                                                Style="{StaticResource FlatIconButton}"
                                                ToolTip="Выход из аккаунта">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ExitToApp" Width="15" Height="15"
                                                                         Foreground="#EF5350" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Выход" FontSize="12" Foreground="#EF5350" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Avatar editor block -->
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,12">
                                        <!-- Avatar circle: image when set, else first-letter -->
                                        <Grid Width="72" Height="72">
                                            <Border Width="72" Height="72" CornerRadius="36"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Visibility="{Binding HasAvatar, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstLetterConverter}, FallbackValue='?'}"
                                                           FontSize="28" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="72" Height="72" CornerRadius="36"
                                                    ClipToBounds="True"
                                                    Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Image Source="{Binding AvatarImagePath, Converter={StaticResource ImagePathConverter}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <!-- Camera overlay button -->
                                            <Border Width="24" Height="24" CornerRadius="12"
                                                    Background="{DynamicResource AccentBrush}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding BrowseAvatarCommand}"/>
                                                </Border.InputBindings>
                                                <materialDesign:PackIcon Kind="Camera" Width="13" Height="13"
                                                                         Foreground="White"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName, FallbackValue='—'}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForeground}"/>
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="12" Foreground="{DynamicResource SecondaryForeground}"
                                                       Margin="0,2,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Command="{Binding BrowseAvatarCommand}"
                                                        Height="28" Padding="8,0"
                                                        materialDesign:ButtonAssist.CornerRadius="6"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="Изменить фото" FontSize="11"
                                                               Foreground="{DynamicResource PrimaryForeground}"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Command="{Binding ClearAvatarCommand}"
                                                        Height="28" Padding="8,0"
                                                        materialDesign:ButtonAssist.CornerRadius="6"
                                                        Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Удалить" FontSize="11" Foreground="#EF5350"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ФИО + Логин fields -->
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>

                                    <TextBlock Text="Отображаемое имя / ФИО"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryForeground}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Иванов Иван Иванович"
                                             materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Foreground="{DynamicResource PrimaryForeground}"
                                             Margin="0,0,0,12"/>

                                    <TextBlock Text="Логин (имя пользователя)"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryForeground}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Username, Mode=OneWay}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Foreground="{DynamicResource PrimaryForeground}"
                                             IsReadOnly="True"
                                             Opacity="0.65"
                                             Margin="0,0,0,12"/>

                                    <Button Style="{StaticResource AppRaisedButton}"
                                            Command="{Binding SaveProfileCommand}"
                                            materialDesign:ButtonAssist.CornerRadius="8"
                                            HorizontalAlignment="Left"
                                            Height="36" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Сохранить профиль" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>

                                    <!-- Account links -->
                                    <Button Style="{StaticResource FlatIconButton}"
                                            Command="{Binding ChangePasswordCommand}"
                                            HorizontalAlignment="Left"
                                            HorizontalContentAlignment="Left"
                                            Padding="0,8"
                                            Visibility="{Binding IsCorporate, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="KeyChange" Width="16" Height="16"
                                                                     Foreground="{DynamicResource AccentBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Сменить пароль"
                                                       FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource FlatIconButton}"
                                            Command="{Binding ChangeEmailCommand}"
                                            HorizontalAlignment="Left"
                                            HorizontalContentAlignment="Left"
                                            Padding="0,8"
                                            Visibility="{Binding IsCorporate, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="EmailOutline" Width="16" Height="16"
                                                                     Foreground="{DynamicResource AccentBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Сменить e-mail"
                                                       FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- PIN для защиты заметок -->
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>
                                    <StackPanel>
                                        <Button Style="{StaticResource FlatIconButton}"
                                                Command="{Binding ChangeNotesPinCommand}"
                                                HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left"
                                                Padding="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="LockReset" Width="16" Height="16"
                                                                         Foreground="{DynamicResource AccentBrush}"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="13"
                                                           Foreground="{DynamicResource AccentBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Установить PIN заметок"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasNotesPin}" Value="True">
                                                                    <Setter Property="Text" Value="Сменить PIN заметок"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding NotesPinStatus}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryForeground}"
                                                   Margin="24,2,0,0" Opacity="0.85"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Right: Security info card -->
                            <Border Grid.Column="2" Style="{StaticResource AppCard}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Безопасность"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForeground}"
                                               Margin="0,0,0,16"/>

                                    <!-- Encryption info row -->
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="ShieldLock" Width="18" Height="18"
                                                                     Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Шифрование активно"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#4CAF50" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="ГОСТ Р 34.12-2015 «Кузнечик» CTR"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForeground}"
                                                   Margin="26,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <materialDesign:PackIcon Kind="Fingerprint" Width="16" Height="16"
                                                                     Foreground="{DynamicResource AccentBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Хэширование" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForeground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="ГОСТ Р 34.11-2012 «Стрибог-256»"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForeground}"
                                                   Margin="24,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <materialDesign:PackIcon Kind="DatabaseLock" Width="16" Height="16"
                                                                     Foreground="{DynamicResource AccentBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="KDF" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForeground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="PBKDF2-HMAC-Стрибог-256, 100 000 итераций"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForeground}"
                                                   Margin="24,0,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Notifications section (like YouGile) -->
                        <Border Style="{StaticResource AppCard}">
                            <StackPanel>
                                <TextBlock Text="О программе"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForeground}"
                                           Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" Style="{StaticResource SubHeading}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="ConSecOrg — Защищённый органайзер" Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Автор:" Style="{StaticResource SubHeading}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Максутов Р.Ф., КИ22-02/2Б, СФУ ИКИТ 2026" Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Версия:" Style="{StaticResource SubHeading}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="1.0.0" Foreground="{DynamicResource PrimaryForeground}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
