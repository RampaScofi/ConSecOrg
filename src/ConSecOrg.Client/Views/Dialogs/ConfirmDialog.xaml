<Window x:Class="ConSecOrg.Client.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title=""
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="14"
            Background="{DynamicResource SecondaryBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="28,24,28,22">
        <Border.Effect>
            <DropShadowEffect Color="#000" Opacity="0.35" BlurRadius="28" ShadowDepth="6" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <!-- Icon + Title -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="42" Height="42" CornerRadius="21" Margin="0,0,14,0"
                        Background="#1AF44336">
                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                             Width="22" Height="22"
                                             Foreground="#EF5350"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForeground}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Message -->
            <TextBlock x:Name="MessageText"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryForeground}"
                       LineHeight="22"
                       Margin="0,0,0,24"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="CancelBtn"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Height="40" FontSize="14"
                        Click="CancelBtn_Click"
                        IsCancel="True"/>

                <Button Grid.Column="2"
                        x:Name="ConfirmBtn"
                        Style="{StaticResource AppRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Height="40" FontSize="14"
                        Background="#EF5350" BorderBrush="#EF5350"
                        Foreground="{DynamicResource ButtonForegroundBrush}"
                        Click="ConfirmBtn_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
