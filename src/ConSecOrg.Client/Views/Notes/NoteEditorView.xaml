<UserControl x:Class="ConSecOrg.Client.Views.Notes.NoteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mdXaml="clr-namespace:MdXaml;assembly=MdXaml"
             Background="{DynamicResource PrimaryBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header toolbar ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding CancelCommand}" Content="Отмена"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Height="34" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource AppRaisedButton}"
                            Command="{Binding SaveCommand}" IsDefault="True"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Height="34">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Сохранить" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Meta row: title, level, pin ── -->
        <Border Grid.Row="1"
                Background="{DynamicResource SecondaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding NoteTitle, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Заголовок заметки"
                         materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="{DynamicResource PrimaryForeground}"
                         CaretBrush="{DynamicResource PrimaryForeground}"
                         Width="340" FontSize="14" Margin="0,0,14,0"/>

                <ComboBox ItemsSource="{Binding SecurityLevels}"
                          SelectedItem="{Binding SecurityLevel}"
                          materialDesign:HintAssist.Hint="Уровень"
                          materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Foreground="{DynamicResource PrimaryForeground}"
                          Width="160" Margin="0,0,14,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{DynamicResource PrimaryForeground}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="Public">
                                                <Setter Property="Text" Value="Открытый"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Internal">
                                                <Setter Property="Text" Value="Внутренний"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Confidential">
                                                <Setter Property="Text" Value="Конфиденциальный"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Secret">
                                                <Setter Property="Text" Value="Секретный"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox Content="Закрепить"
                          IsChecked="{Binding IsPinned}"
                          Foreground="{DynamicResource PrimaryForeground}"
                          VerticalAlignment="Center" Margin="0,0,14,0"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorText}"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- ── Tags + Priority row ── -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <!-- Priority selector -->
                <materialDesign:PackIcon Kind="Flag" Width="16" Height="16"
                                         Foreground="{DynamicResource SecondaryForeground}"
                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding NotePriorities}"
                          SelectedItem="{Binding NotePriority}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Foreground="{DynamicResource PrimaryForeground}"
                          Width="140" Margin="0,0,20,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="Low">
                                                <Setter Property="Text" Value="Низкий"/>
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Normal">
                                                <Setter Property="Text" Value="Обычный"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="High">
                                                <Setter Property="Text" Value="Высокий"/>
                                                <Setter Property="Foreground" Value="#FF9800"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Critical">
                                                <Setter Property="Text" Value="Критичный"/>
                                                <Setter Property="Foreground" Value="#F44336"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Tags input -->
                <materialDesign:PackIcon Kind="Tag" Width="16" Height="16"
                                         Foreground="{DynamicResource SecondaryForeground}"
                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Vertical">
                    <TextBox Text="{Binding TagsInput, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Теги через запятую: security, work..."
                             materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="{DynamicResource PrimaryForeground}"
                             CaretBrush="{DynamicResource PrimaryForeground}"
                             Width="380" FontSize="12"/>
                    <!-- Tag chips -->
                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AccentAlphaBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="12"
                                        Margin="0,0,6,2" Padding="10,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource FlatIconButton}"
                                                Width="14" Height="14" Margin="4,0,0,0"
                                                Command="{Binding DataContext.RemoveTagCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Close" Width="9" Height="9"
                                                                     Foreground="{DynamicResource AccentBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Timer section ── -->
        <Border Grid.Row="3"
                Background="{DynamicResource SecondaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Toggle -->
                <ToggleButton IsChecked="{Binding TimerEnabled}"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              VerticalAlignment="Center"/>
                <materialDesign:PackIcon Kind="TimerSand" Width="16" Height="16"
                                         Foreground="{DynamicResource SecondaryForeground}"
                                         Margin="8,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Таймер уничтожения" FontSize="13"
                           Foreground="{DynamicResource SecondaryForeground}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Mode toggle + fields (shown only when timer enabled) -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding TimerEnabled, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Mode toggle -->
                    <Border CornerRadius="8" Background="{DynamicResource PrimaryBackground}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Через..."
                                         IsChecked="{Binding IsTimerRelative, Mode=OneWay}"
                                         GroupName="TimerMode"
                                         Command="{Binding SetTimerModeCommand}"
                                         CommandParameter="Relative"
                                         Style="{StaticResource MaterialDesignTabRadioButton}"
                                         Margin="0,0,4,0" Padding="14,5" FontSize="12"/>
                            <RadioButton Content="Дата и время"
                                         IsChecked="{Binding IsTimerAbsolute, Mode=OneWay}"
                                         GroupName="TimerMode"
                                         Command="{Binding SetTimerModeCommand}"
                                         CommandParameter="Absolute"
                                         Style="{StaticResource MaterialDesignTabRadioButton}"
                                         Padding="14,5" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Relative mode: only duration dropdown -->
                    <ComboBox ItemsSource="{Binding DurationLabels}"
                              SelectedItem="{Binding SelectedDurationLabel}"
                              materialDesign:HintAssist.Hint="Через сколько"
                              materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="{DynamicResource PrimaryForeground}"
                              Width="160" Margin="0,0,12,0" VerticalAlignment="Center"
                              Visibility="{Binding IsTimerRelative, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Absolute mode: date + time -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsTimerAbsolute, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DatePicker SelectedDate="{Binding TimerDate}"
                                    materialDesign:HintAssist.Hint="Дата"
                                    materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    Foreground="{DynamicResource PrimaryForeground}"
                                    Width="150" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Hours}"
                                  SelectedItem="{Binding TimerHour}"
                                  materialDesign:HintAssist.Hint="Час"
                                  materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Foreground="{DynamicResource PrimaryForeground}"
                                  Width="70" Margin="0,0,6,0"/>
                        <TextBlock Text=":" VerticalAlignment="Center"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForeground}"
                                   Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Minutes}"
                                  SelectedItem="{Binding TimerMinute}"
                                  materialDesign:HintAssist.Hint="Мин"
                                  materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Foreground="{DynamicResource PrimaryForeground}"
                                  Width="70"/>
                    </StackPanel>

                    <!-- Result preview -->
                    <Border Background="#FF9800" CornerRadius="6"
                            Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Fire" Width="13" Height="13"
                                                     Foreground="White" Margin="0,0,4,0"/>
                            <TextBlock FontSize="11" Foreground="White" FontWeight="Medium">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:dd.MM.yyyy} {1:D2}:{2:D2}">
                                        <Binding Path="TimerDate"/>
                                        <Binding Path="TimerHour"/>
                                        <Binding Path="TimerMinute"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Two-panel editor ── -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Markdown input -->
            <Grid Grid.Column="0" Background="{DynamicResource SecondaryBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="16,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Markdown" Style="{StaticResource SubHeading}" FontSize="11"/>
                </Border>
                <TextBox Grid.Row="1"
                         Text="{Binding MarkdownContent, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas" FontSize="13"
                         Padding="16"
                         Background="{DynamicResource SecondaryBackground}"
                         Foreground="{DynamicResource PrimaryForeground}"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource AccentBrush}"/>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"/>

            <!-- Preview -->
            <Grid Grid.Column="2" Background="{DynamicResource PrimaryBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="16,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Предпросмотр" Style="{StaticResource SubHeading}" FontSize="11"/>
                </Border>
                <mdXaml:MarkdownScrollViewer Grid.Row="1"
                                              Markdown="{Binding MarkdownContent}"
                                              Padding="16"
                                              Background="{DynamicResource PrimaryBackground}"
                                              Foreground="{DynamicResource PrimaryForeground}">
                    <mdXaml:MarkdownScrollViewer.MarkdownStyle>
                        <Style TargetType="FlowDocument">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </mdXaml:MarkdownScrollViewer.MarkdownStyle>
                </mdXaml:MarkdownScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
