<UserControl x:Class="ConSecOrg.Client.Views.Dashboard.SecurityDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="24,20">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <TextBlock Text="Безопасность" Style="{StaticResource PageTitle}" Margin="0"/>
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        HorizontalAlignment="Right"
                        Command="{Binding LoadCommand}"
                        ToolTip="Обновить">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                </Button>
            </Grid>

            <!-- Tiles row 1 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">

                <!-- Encryption tile -->
                <Border Style="{StaticResource AppCard}" Width="260" Margin="0,0,16,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="ShieldLock"
                                                     Width="32" Height="32"
                                                     Foreground="#4CAF50"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="Шифрование"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForeground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="ГОСТ Р 34.12-2015"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="#4CAF50"/>
                        <TextBlock Text="Кузнечик CTR / HMAC-Стрибог-256"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForeground}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Last login tile -->
                <Border Style="{StaticResource AppCard}" Width="260" Margin="0,0,16,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Login"
                                                     Width="32" Height="32"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="Последний вход"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForeground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Dashboard.LastLoginAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}', FallbackValue='—'}"
                                   FontSize="14"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                        <TextBlock Text="{Binding Dashboard.LastLoginIp, StringFormat='IP: {0}', FallbackValue=''}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForeground}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Active sessions tile -->
                <Border Style="{StaticResource AppCard}" Width="260">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Devices"
                                                     Width="32" Height="32"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="Сессии"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForeground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Dashboard.ActiveSessionsCount, StringFormat='{}{0} активных', FallbackValue='—'}"
                                   FontSize="14"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Notes by security level -->
            <Border Style="{StaticResource AppCard}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Заметки по уровням безопасности"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForeground}"
                               Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Public -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border Background="#4CAF50" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" Width="80">
                                <TextBlock Text="{Binding Dashboard.NotesByLevel.Public, FallbackValue='0'}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Открытые" FontSize="11"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Internal -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Border Background="#2196F3" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" Width="80">
                                <TextBlock Text="{Binding Dashboard.NotesByLevel.Internal, FallbackValue='0'}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Внутренние" FontSize="11"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Confidential -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Background="#FF9800" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" Width="80">
                                <TextBlock Text="{Binding Dashboard.NotesByLevel.Confidential, FallbackValue='0'}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Конфиден." FontSize="11"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Secret -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <Border Background="#F44336" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" Width="80">
                                <TextBlock Text="{Binding Dashboard.NotesByLevel.Secret, FallbackValue='0'}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Секретные" FontSize="11"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recent audit events -->
            <Border Style="{StaticResource AppCard}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Последние события аудита"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForeground}"
                               Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Dashboard.RecentAuditEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0"
                                                             Kind="History"
                                                             Width="16" Height="16"
                                                             Foreground="{DynamicResource SecondaryForeground}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Action}"
                                               Foreground="{DynamicResource PrimaryForeground}"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Timestamp, Converter={StaticResource DateTimeToRelativeConverter}}"
                                               Style="{StaticResource SubHeading}"
                                               FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,8,0,0"/>
        </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
