<Window x:Class="ConSecOrg.Client.Views.Company.SharedTaskEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ConSecOrg.Client.ViewModels.Company"
        Title="{Binding DialogTitle}"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SecondaryBackground}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dialog title -->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryForeground}"
                   Margin="0,0,0,20"/>

        <!-- Title input -->
        <TextBox Grid.Row="1"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 md:HintAssist.Hint="Название задачи"
                 md:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                 md:HintAssist.Background="Transparent"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Foreground="{DynamicResource PrimaryForeground}"
                 CaretBrush="{DynamicResource PrimaryForeground}"
                 FontSize="14" Margin="0,0,0,14">
            <TextBox.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
            </TextBox.InputBindings>
        </TextBox>

        <!-- Priority + DueDate row -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Priority (int 0/1/2/3) -->
            <ComboBox Grid.Column="0"
                      ItemsSource="{x:Static vm:SharedTaskEditViewModel.PriorityValues}"
                      SelectedItem="{Binding Priority}"
                      md:HintAssist.Hint="Приоритет"
                      md:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Foreground="{DynamicResource PrimaryForeground}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ChartBar" Width="14" Height="14"
                                         VerticalAlignment="Center" Margin="0,0,6,0">
                                <md:PackIcon.Style>
                                    <Style TargetType="md:PackIcon">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="0">
                                                <Setter Property="Foreground" Value="#616161"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="2">
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="3">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </md:PackIcon.Style>
                            </md:PackIcon>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForeground}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Нормально"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="0">
                                                <Setter Property="Text" Value="Не важно"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="2">
                                                <Setter Property="Text" Value="Важно"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="3">
                                                <Setter Property="Text" Value="Критично!"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- DueDate -->
            <DatePicker Grid.Column="2"
                        SelectedDate="{Binding DueDate}"
                        md:HintAssist.Hint="Дедлайн (необязательно)"
                        md:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Foreground="{DynamicResource PrimaryForeground}"/>
        </Grid>

        <!-- Tags -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBox Text="{Binding TagsInput, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="Теги через запятую: work, urgent..."
                     md:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="{DynamicResource PrimaryForeground}"
                     CaretBrush="{DynamicResource PrimaryForeground}"
                     FontSize="12"/>
            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource AccentAlphaBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Margin="0,0,6,4" Padding="10,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="11" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource FlatIconButton}"
                                        Width="14" Height="14" Margin="4,0,0,0"
                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <md:PackIcon Kind="Close" Width="9" Height="9"
                                                 Foreground="{DynamicResource AccentBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Assignee — shown for Admin/Manager only -->
        <Border Grid.Row="4" Margin="0,0,0,14"
                Visibility="{Binding CanAssign, Converter={StaticResource BoolToVisibilityConverter}}">
            <ComboBox ItemsSource="{Binding AvailableMembers}"
                      SelectedItem="{Binding SelectedAssignee}"
                      md:HintAssist.Hint="Исполнитель (необязательно)"
                      md:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Foreground="{DynamicResource PrimaryForeground}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource AccentBrush}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Username}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForeground}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Border>

        <!-- Regular user — auto-assigned note -->
        <TextBlock Grid.Row="4"
                   Text="Задача будет назначена на вас автоматически"
                   Foreground="{DynamicResource SecondaryForeground}"
                   FontSize="12" Margin="0,0,0,14" FontStyle="Italic">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanAssign}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Description -->
        <TextBox Grid.Row="5"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 md:HintAssist.Hint="Описание (необязательно)"
                 md:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                 Foreground="{DynamicResource PrimaryForeground}"
                 CaretBrush="{DynamicResource PrimaryForeground}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="80" MaxHeight="160"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="13" Margin="0,0,0,6"/>

        <!-- Error -->
        <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}"
                   Foreground="#EF5350" FontSize="12" Margin="0,4,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                   TextWrapping="Wrap"/>

        <!-- Buttons -->
        <Grid Grid.Row="7" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"/>
            <Button Grid.Column="1"
                    Content="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Style="{StaticResource AppRaisedButton}"
                    md:ButtonAssist.CornerRadius="8"
                    Height="36" Padding="20,0"/>
            <Button Grid.Column="3"
                    Content="Отмена"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    md:ButtonAssist.CornerRadius="8"
                    Height="36" Padding="20,0"/>
        </Grid>
    </Grid>
</Window>
