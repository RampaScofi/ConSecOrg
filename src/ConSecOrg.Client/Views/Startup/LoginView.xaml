<UserControl x:Class="ConSecOrg.Client.Views.Startup.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackground}">

    <Grid>
        <!-- Back button — top left -->
        <Button Style="{StaticResource MaterialDesignFlatButton}"
                Command="{Binding GoBackCommand}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,16,0,0"
                Foreground="{DynamicResource SecondaryForeground}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Назад к выбору режима" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Button>

        <Border Width="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource AppCard}"
                Padding="40,36">

            <StackPanel>
                <!-- Logo -->
                <materialDesign:PackIcon Kind="ShieldLock"
                                         Width="52" Height="52"
                                         Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,8"/>
                <TextBlock Text="Вход в систему"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForeground}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>

                <!-- Username -->
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Имя пользователя"
                         materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="{DynamicResource PrimaryForeground}"
                         CaretBrush="{DynamicResource PrimaryForeground}"
                         Margin="0,0,0,16"/>

                <!-- Password -->
                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="Пароль"
                             materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Foreground="{DynamicResource PrimaryForeground}"
                             CaretBrush="{DynamicResource PrimaryForeground}"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Margin="0,0,0,8"/>

                <!-- Error text -->
                <TextBlock Text="{Binding ErrorText}"
                           Style="{StaticResource ErrorText}"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibilityConverter}}"
                           Margin="0,0,0,12"/>

                <!-- Login button -->
                <Button Style="{StaticResource AppRaisedButton}"
                        Content="Войти"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        Height="44"
                        FontSize="15"
                        Margin="0,8,0,0"/>

                <!-- Loading indicator -->
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             Margin="0,12,0,0"
                             Height="3"/>

                <!-- Register link -->
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding NavigateRegisterCommand}"
                        Content="Нет аккаунта? Зарегистрироваться"
                        Foreground="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
