<UserControl x:Class="ConSecOrg.Client.Views.Startup.PinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackground}">

    <Grid>
        <Border Width="420"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource AppCard}"
                Padding="44,40">

            <StackPanel>
                <!-- Back button -->
                <Button Style="{StaticResource FlatIconButton}"
                        Command="{Binding GoBackCommand}"
                        HorizontalAlignment="Left"
                        Padding="4,4"
                        Margin="0,0,0,8"
                        ToolTip="Вернуться к выбору режима">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16"
                                                 Foreground="{DynamicResource SecondaryForeground}"
                                                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Назад" FontSize="13"
                                   Foreground="{DynamicResource SecondaryForeground}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Icon -->
                <Border Width="68" Height="68" CornerRadius="34"
                        Background="{DynamicResource AccentAlphaBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                    <materialDesign:PackIcon Kind="LockOutline"
                                             Width="36" Height="36"
                                             Foreground="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock Text="{Binding Title}"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForeground}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <!-- Subtitle -->
                <TextBlock HorizontalAlignment="Center"
                           Margin="0,0,0,28"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryForeground}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Введите PIN для доступа к данным"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingPin}" Value="True">
                                    <Setter Property="Text" Value="Придумайте PIN-код для защиты данных"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- PIN input -->
                <PasswordBox x:Name="PinBox"
                             materialDesign:HintAssist.Hint="PIN-код (мин. 4 символа)"
                             materialDesign:HintAssist.Foreground="{DynamicResource PrimaryForeground}"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Foreground="{DynamicResource PrimaryForeground}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             PasswordChanged="PinBox_PasswordChanged"
                             Margin="0,0,0,16"
                             FontSize="15"
                             FontFamily="Courier New"
                             MaxLength="32"/>

                <!-- Confirm PIN (only for new PIN creation) -->
                <PasswordBox x:Name="ConfirmPinBox"
                             materialDesign:HintAssist.Hint="Подтвердите PIN-код"
                             materialDesign:HintAssist.Foreground="{DynamicResource PrimaryForeground}"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Foreground="{DynamicResource PrimaryForeground}"
                             PasswordChanged="ConfirmPinBox_PasswordChanged"
                             Margin="0,0,0,8"
                             FontSize="15"
                             FontFamily="Courier New"
                             MaxLength="32"
                             Visibility="{Binding IsSettingPin, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorText}"
                           Style="{StaticResource ErrorText}"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibilityConverter}}"
                           Margin="0,0,0,12"/>

                <!-- Submit button -->
                <Button Command="{Binding SubmitCommand}"
                        HorizontalAlignment="Stretch"
                        Height="46"
                        FontSize="15"
                        Margin="0,8,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AppRaisedButton}">
                            <Setter Property="Content" Value="Войти"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingPin}" Value="True">
                                    <Setter Property="Content" Value="Создать PIN и войти"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Loading -->
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             Margin="0,10,0,0"
                             Height="3"/>

                <!-- Reset PIN link (only when PIN exists) -->
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ResetPinCommand}"
                        Content="Сбросить PIN (потеря доступа к данным)"
                        Foreground="{DynamicResource SecondaryForeground}"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Margin="0,12,0,0"
                        Opacity="0.7"
                        Visibility="{Binding IsSettingPin, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
