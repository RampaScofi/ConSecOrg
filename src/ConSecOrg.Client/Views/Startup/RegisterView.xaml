<UserControl x:Class="ConSecOrg.Client.Views.Startup.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackground}">
    <Grid>
        <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource AppCard}" Padding="44,40">
            <StackPanel>
                <materialDesign:PackIcon Kind="AccountPlus" Width="52" Height="52"
                    Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Регистрация" FontSize="22" FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryForeground}" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Имя пользователя"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Email"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                <PasswordBox x:Name="PwdBox"
                             materialDesign:HintAssist.Hint="Пароль (мин. 12 символов)"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             PasswordChanged="PwdBox_PasswordChanged" Margin="0,0,0,12"/>
                <PasswordBox x:Name="ConfirmPwdBox"
                             materialDesign:HintAssist.Hint="Подтвердите пароль"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             PasswordChanged="ConfirmPwdBox_PasswordChanged" Margin="0,0,0,8"/>

                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibilityConverter}}"
                           Margin="0,0,0,12"/>

                <Button Command="{Binding RegisterCommand}" Content="Создать аккаунт"
                        Style="{StaticResource AppRaisedButton}"
                        HorizontalAlignment="Stretch" Height="46" FontSize="15" Margin="0,8,0,12"/>

                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             Height="3" Margin="0,0,0,8"/>

                <Button Command="{Binding BackToLoginCommand}" Content="← Войти в существующий аккаунт"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
