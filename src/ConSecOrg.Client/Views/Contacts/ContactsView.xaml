<UserControl x:Class="ConSecOrg.Client.Views.Contacts.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackground}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Contact list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Контакты" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Search users button (corporate only) -->
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding ToggleUserSearchCommand}"
                                    ToolTip="Найти пользователя"
                                    Visibility="{Binding IsCorporate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="AccountSearch" Width="18" Height="18"/>
                            </Button>
                            <!-- Pending requests button -->
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding ToggleRequestsCommand}"
                                    ToolTip="Входящие заявки"
                                    Visibility="{Binding IsCorporate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <materialDesign:PackIcon Kind="AccountMultiplePlus" Width="18" Height="18"/>
                                    <Border Background="#EF5350" CornerRadius="7" Width="14" Height="14"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                            Visibility="{Binding PendingCount, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding PendingCount}"
                                                   FontSize="9" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding NewContactCommand}"
                                    ToolTip="Новый контакт вручную">
                                <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- User search panel -->
                    <StackPanel Visibility="{Binding ShowUserSearch, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding UserSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Поиск по имени или e-mail"
                                     materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                     Foreground="{DynamicResource PrimaryForeground}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="12">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchUsersCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    Command="{Binding SearchUsersCommand}"
                                    Style="{StaticResource AppRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="6"
                                    Height="32" Padding="10,0" Content="Найти" FontSize="12"/>
                        </Grid>
                        <TextBlock Text="{Binding SearchStatusText}"
                                   FontSize="11" Foreground="{DynamicResource SecondaryForeground}"
                                   Visibility="{Binding SearchStatusText, Converter={StaticResource NullToVisibilityConverter}}"
                                   Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Margin="0,0,0,3" Padding="8,6">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Username}" FontWeight="Medium"
                                                           Foreground="{DynamicResource PrimaryForeground}" FontSize="12"/>
                                                <TextBlock Text="{Binding Email}"
                                                           Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.SendRequestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AppRaisedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="6"
                                                    Height="28" Padding="8,0" FontSize="11"
                                                    Content="+ Добавить"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Pending requests panel -->
                    <StackPanel Visibility="{Binding ShowRequests, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Входящие заявки" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,6"/>
                        <TextBlock Text="Нет входящих заявок"
                                   FontSize="11" Foreground="{DynamicResource SecondaryForeground}"
                                   Visibility="{Binding HasNoPendingRequests, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding PendingRequests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Margin="0,0,0,4" Padding="8,6">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SenderUsername}" FontWeight="Medium"
                                                           Foreground="{DynamicResource PrimaryForeground}" FontSize="12"/>
                                                <TextBlock Text="{Binding SenderEmail}"
                                                           Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource AppRaisedButton}"
                                                        materialDesign:ButtonAssist.CornerRadius="6"
                                                        Height="28" Padding="8,0" FontSize="11" Margin="0,0,4,0"
                                                        Content="✓ Принять"/>
                                                <Button Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        materialDesign:ButtonAssist.CornerRadius="6"
                                                        Height="28" Padding="8,0" FontSize="11"
                                                        Content="✗"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Search filter box -->
            <Border Grid.Row="1" Padding="8,6"
                    Background="{DynamicResource SecondaryBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding FilterQuery, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Поиск контактов..."
                             materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                             materialDesign:HintAssist.IsFloating="False"
                             Foreground="{DynamicResource PrimaryForeground}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="12" Height="34" Padding="8,4"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                            Width="30" Height="34" Padding="0" Margin="4,0,0,0"
                            Command="{Binding ClearFilterCommand}"
                            ToolTip="Сбросить фильтр"
                            Visibility="{Binding FilterQuery, Converter={StaticResource NullToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14"
                                                 Foreground="{DynamicResource SecondaryForeground}"/>
                    </Button>
                </Grid>
            </Border>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Contacts}"
                     SelectedItem="{Binding SelectedContact}"
                     Background="{DynamicResource SecondaryBackground}"
                     BorderThickness="0"
                     Padding="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar circle -->
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                    Background="{DynamicResource AccentAlpha2Brush}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource FirstLetterConverter}}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding AvatarBase64, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <Image Source="{Binding AvatarBase64, Converter={StaticResource Base64ToImageConverter}}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding AvatarBase64, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <!-- Name + email -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Pin" Width="12" Height="12"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,4,0"
                                                             Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryForeground}" FontSize="13"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Email, FallbackValue=''}"
                                           Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
                            </StackPanel>
                            <!-- Three-dots menu -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="26" Height="26" Padding="0" Opacity="0.75"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Click="DotsButton_Click">
                                <materialDesign:PackIcon Kind="DotsVertical" Width="14" Height="14"/>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📌  Закрепить / Открепить"
                                                  Command="{Binding PlacementTarget.Tag.PinContactCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="💬  Перейти в личный чат"
                                                  Command="{Binding PlacementTarget.Tag.OpenChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="🗂  Совместные проекты"
                                                  Command="{Binding PlacementTarget.Tag.ShowSharedProjectsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="✏  Редактировать"
                                                  Command="{Binding PlacementTarget.Tag.EditContactCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="🗑  Удалить" Foreground="#EF5350"
                                                  Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <EventSetter Event="MouseLeftButtonUp"
                                     Handler="ContactItem_Click"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- Divider -->
        <Border Grid.Column="1"
                Background="{DynamicResource BorderBrush}"/>

        <!-- Detail / Edit panel -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      Padding="32,24">
            <StackPanel>
                <!-- Global notification bar (errors / confirmations) -->
                <Border Background="{DynamicResource AccentAlphaBrush}"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                        Visibility="{Binding NotificationMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding NotificationMessage}"
                               Foreground="{DynamicResource PrimaryForeground}" FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- No selection -->
                <StackPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,80,0,0">
                    <materialDesign:PackIcon Kind="AccountOff"
                                             Width="64" Height="64"
                                             Foreground="{DynamicResource SecondaryForeground}"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,16"/>
                    <TextBlock Text="Выберите контакт"
                               Style="{StaticResource SubHeading}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- New contact form -->
                <StackPanel Visibility="{Binding IsCreatingNew, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Новый контакт"
                               Style="{StaticResource PageTitle}"
                               Margin="0,0,0,24"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Имя *"
                             materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                             Foreground="{DynamicResource PrimaryForeground}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,16"/>
                    <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Email"
                             materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                             Foreground="{DynamicResource PrimaryForeground}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,16"/>
                    <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Телефон"
                             materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                             Foreground="{DynamicResource PrimaryForeground}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,16"/>
                    <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Заметки"
                             materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                             Foreground="{DynamicResource PrimaryForeground}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True"
                             Height="80"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AppRaisedButton}"
                                Command="{Binding SaveCommand}"
                                Content="Создать контакт"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CancelEditCommand}"
                                Content="Отмена"/>
                    </StackPanel>
                </StackPanel>

                <!-- View mode -->
                <StackPanel Visibility="{Binding SelectedContact, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid Margin="0,0,0,24">
                        <TextBlock Text="{Binding SelectedContact.Name}"
                                   Style="{StaticResource PageTitle}"
                                   Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding OpenChatCommand}"
                                    CommandParameter="{Binding SelectedContact}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding IsCorporate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MessageOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Написать" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding StartEditCommand}"
                                    Content="Изменить"
                                    Visibility="{Binding IsEditing, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- View fields -->
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                        <TextBlock Text="Email" Style="{StaticResource SubHeading}"/>
                        <TextBlock Text="{Binding SelectedContact.Email, FallbackValue='—'}"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   FontSize="14"
                                   Margin="0,4,0,16"/>
                        <TextBlock Text="Телефон" Style="{StaticResource SubHeading}"/>
                        <TextBlock Text="{Binding SelectedContact.Phone, FallbackValue='—'}"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   FontSize="14"
                                   Margin="0,4,0,16"/>
                        <TextBlock Text="Заметки" Style="{StaticResource SubHeading}"/>
                        <TextBlock Text="{Binding SelectedContact.Notes, FallbackValue='—'}"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Edit form -->
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Имя"
                                 materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                 Foreground="{DynamicResource PrimaryForeground}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>
                        <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Email"
                                 materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                 Foreground="{DynamicResource PrimaryForeground}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>
                        <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Телефон"
                                 materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                 Foreground="{DynamicResource PrimaryForeground}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Заметки"
                                 materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                 Foreground="{DynamicResource PrimaryForeground}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True"
                                 Height="80"
                                 VerticalContentAlignment="Top"
                                 Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AppRaisedButton}"
                                    Command="{Binding SaveCommand}"
                                    Content="Сохранить"
                                    Margin="0,0,8,0"/>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding CancelEditCommand}"
                                    Content="Отмена"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Shared projects panel -->
                    <Border Margin="0,16,0,0"
                            Visibility="{Binding ShowContactSharedProjects, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Совместные проекты"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForeground}"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding HideSharedProjectsCommand}"
                                        Width="24" Height="24" Padding="0">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                            <!-- Loading indicator -->
                            <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,8"
                                         Visibility="{Binding IsLoadingSharedProjects, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <!-- Status text (empty state) -->
                            <TextBlock Text="{Binding SharedProjectsStatusText}"
                                       FontSize="12" Foreground="{DynamicResource SecondaryForeground}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding SharedProjectsStatusText, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <!-- Project list -->
                            <ItemsControl ItemsSource="{Binding ContactSharedProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,4"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="6"
                                                Command="{Binding DataContext.NavigateToSharedProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FolderAccountOutline"
                                                                         Width="16" Height="16"
                                                                         Margin="0,0,8,0"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PrimaryForeground}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
