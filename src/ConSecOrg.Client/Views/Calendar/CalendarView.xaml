<UserControl x:Class="ConSecOrg.Client.Views.Calendar.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ConSecOrg.Client.ViewModels.Calendar"
             Background="{DynamicResource PrimaryBackground}"
             TextElement.Foreground="{DynamicResource PrimaryForeground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Календарь" Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center"/>

                <!-- Center: Month/Week nav -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Style="{StaticResource FlatIconButton}"
                                Command="{Binding PrevMonthCommand}"
                                Width="30" Height="30" Margin="0,0,4,0">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16"
                                                     Foreground="{DynamicResource PrimaryForeground}"/>
                        </Button>
                        <TextBlock Text="{Binding MonthTitle}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   VerticalAlignment="Center" MinWidth="180" TextAlignment="Center"/>
                        <Button Style="{StaticResource FlatIconButton}"
                                Command="{Binding NextMonthCommand}"
                                Width="30" Height="30" Margin="4,0,0,0">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"
                                                     Foreground="{DynamicResource PrimaryForeground}"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Style="{StaticResource FlatIconButton}"
                                Command="{Binding PrevWeekCommand}"
                                Width="30" Height="30" Margin="0,0,4,0">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16"
                                                     Foreground="{DynamicResource PrimaryForeground}"/>
                        </Button>
                        <TextBlock Text="{Binding WeekTitle}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   VerticalAlignment="Center" MinWidth="200" TextAlignment="Center"/>
                        <Button Style="{StaticResource FlatIconButton}"
                                Command="{Binding NextWeekCommand}"
                                Width="30" Height="30" Margin="4,0,0,0">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"
                                                     Foreground="{DynamicResource PrimaryForeground}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Today + View toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding GoToTodayCommand}"
                            Content="Сегодня"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Height="32" FontSize="12" Margin="0,0,12,0"/>
                    <Border CornerRadius="8"
                            Background="{DynamicResource NavActiveBackground}"
                            Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button Height="28" Padding="12,0"
                                    Command="{Binding SwitchViewCommand}"
                                    CommandParameter="Month"
                                    BorderThickness="0" FontSize="12" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" CornerRadius="6"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonthView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Месяц" FontSize="12"/>
                            </Button>
                            <Button Height="28" Padding="12,0"
                                    Command="{Binding SwitchViewCommand}"
                                    CommandParameter="Week"
                                    BorderThickness="0" FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" CornerRadius="6"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeekView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Неделя" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             CONTENT ROW: calendar + optional day panel
        ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════════════
                 MONTH VIEW
            ══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="0" Margin="16,12,16,8"
                  Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Day names header -->
                <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="Пн" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForeground}" Padding="0,4"/>
                    <TextBlock Text="Вт" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForeground}" Padding="0,4"/>
                    <TextBlock Text="Ср" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForeground}" Padding="0,4"/>
                    <TextBlock Text="Чт" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForeground}" Padding="0,4"/>
                    <TextBlock Text="Пт" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForeground}" Padding="0,4"/>
                    <TextBlock Text="Сб" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="#FF7043" Padding="0,4"/>
                    <TextBlock Text="Вс" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="#EF5350" Padding="0,4"/>
                </UniformGrid>

                <!-- Calendar grid — each cell shows day number + task bars -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CalendarDay}">
                            <Button Command="{Binding DataContext.SelectDayCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    BorderThickness="0" Padding="0" Margin="1"
                                    Background="Transparent" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="DayBorder" CornerRadius="6"
                                                Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="1"
                                                MinHeight="80" Padding="4,4">
                                            <StackPanel>
                                                <!-- Day number -->
                                                <Border x:Name="DayCircle" Width="26" Height="26"
                                                        CornerRadius="13" Background="Transparent"
                                                        HorizontalAlignment="Left" Margin="2,0,0,3">
                                                    <TextBlock x:Name="DayText" Text="{Binding DayNumber}"
                                                               FontSize="12" FontWeight="Medium"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Task bars (up to 3) -->
                                                <ItemsControl ItemsSource="{Binding VisibleTasks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CalendarDayTask}">
                                                            <Border CornerRadius="3" Margin="0,0,0,2" Padding="5,2"
                                                                    Background="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="10" Foreground="White"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- "+ N more" overflow -->
                                                <TextBlock x:Name="ExtraText"
                                                           FontSize="10" Margin="4,1,0,0"
                                                           Foreground="{DynamicResource SecondaryForeground}"
                                                           Visibility="{Binding HasExtraTasks, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock.Text>
                                                        <Binding Path="ExtraTaskCount" StringFormat="+ ещё {0}"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource BorderBrush}"/>
                                                <Setter TargetName="DayBorder" Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                                                <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="DayCircle" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="DayText" Property="Foreground" Value="White"/>
                                                <Setter TargetName="DayText" Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsWeekend}" Value="True"/>
                                                    <Condition Binding="{Binding IsToday}" Value="False"/>
                                                    <Condition Binding="{Binding IsCurrentMonth}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="DayText" Property="Foreground" Value="#EF5350"/>
                                            </MultiDataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════
                 WEEK VIEW
            ══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="0"
                  Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <ItemsControl ItemsSource="{Binding WeekDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WeekDayViewModel}">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ShortName}" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                            <Setter Property="Foreground" Value="#EF5350"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DayNumber}" FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WeekDayViewModel}">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Tasks}" Margin="6,6,6,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:WeekTaskItem}">
                                                <Border CornerRadius="4" Margin="0,0,0,4" Padding="8,5"
                                                        Background="{Binding PriorityColor, Converter={StaticResource HexColorToBrushConverter}}">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="11" Foreground="White"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════
                 DAY DETAIL PANEL (slides in from right)
            ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="1" Width="280"
                    Background="{DynamicResource SecondaryBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowDayPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Padding="16,14"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DayPanelTitle}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForeground}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource FlatIconButton}"
                                    Command="{Binding CloseDayPanelCommand}"
                                    Width="28" Height="28">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14"
                                                         Foreground="{DynamicResource SecondaryForeground}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Task list for this day -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <StackPanel>
                            <!-- Tasks section -->
                            <TextBlock Text="ЗАДАЧИ"
                                       FontSize="10" FontWeight="Bold" Opacity="0.5"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Margin="4,0,0,8"/>

                            <!-- Empty state -->
                            <TextBlock FontSize="12" FontStyle="Italic" Opacity="0.5"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Margin="4,0,0,0"
                                       Text="Нет задач на этот день">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DayPanelTasks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding DayPanelTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CalendarDayTask}">
                                        <Border CornerRadius="6" Margin="0,0,0,6" Padding="10,8"
                                                Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" CornerRadius="4"
                                                        Background="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                                        Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource PrimaryForeground}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="2" Margin="12,8,12,14">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding CreateTaskForDayCommand}"
                                HorizontalAlignment="Stretch"
                                Height="36" Margin="0,0,0,6"
                                materialDesign:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Создать задачу" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CreateNoteForDayPanelCommand}"
                                HorizontalAlignment="Stretch"
                                Height="36"
                                materialDesign:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="NoteOutline" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Создать заметку" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
