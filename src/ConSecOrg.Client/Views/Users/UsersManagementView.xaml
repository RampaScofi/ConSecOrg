<UserControl x:Class="ConSecOrg.Client.Views.Users.UsersManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ConSecOrg.Client.ViewModels.Users">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ConSecOrg.Client;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PrimaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="32,24,32,16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountGroup" Width="26" Height="26"
                                             Foreground="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Управление пользователями"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForeground}"
                               VerticalAlignment="Center"/>
                    <Border CornerRadius="12" Padding="10,2" Margin="12,0,0,0"
                            Background="{DynamicResource AccentAlpha2Brush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Users.Count}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="6" Padding="12,6"
                        Background="{DynamicResource SecondaryBackground}"
                        Visibility="{Binding StatusText, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource PrimaryForeground}"
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Search -->
        <Border Grid.Row="1" Padding="32,14,32,14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <TextBox Width="320" HorizontalAlignment="Left"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Поиск по имени или email..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="{DynamicResource PrimaryForeground}"
                     FontSize="13"/>
        </Border>

        <!-- Table -->
        <Grid Grid.Row="2">

            <!-- Loading -->
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Width="36" Height="36" IsIndeterminate="True"
                         VerticalAlignment="Top" HorizontalAlignment="Center"
                         Margin="0,60,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsLoading, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <StackPanel Margin="32,16">

                    <!-- Column headers row -->
                    <Border Background="{DynamicResource SecondaryBackground}"
                            CornerRadius="8,8,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="ПОЛЬЗОВАТЕЛЬ" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                            <TextBlock Grid.Column="2" Text="EMAIL" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                            <TextBlock Grid.Column="3" Text="РОЛЬ" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                            <TextBlock Grid.Column="4" Text="СТАТУС" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                            <TextBlock Grid.Column="5" Text="ПОСЛЕДНИЙ ВХОД" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                            <TextBlock Grid.Column="6" Text="ДЕЙСТВИЯ" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                        </Grid>
                    </Border>

                    <!-- User rows -->
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:UserRow}">
                                <Border Background="{DynamicResource PrimaryBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar circle -->
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                Background="{DynamicResource AccentBrush}">
                                            <TextBlock Text="{Binding Username, Converter={StaticResource FirstLetterConverter}}"
                                                       Foreground="White" FontSize="13" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Username -->
                                        <TextBlock Grid.Column="1" Text="{Binding Username}"
                                                   FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource PrimaryForeground}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Email -->
                                        <TextBlock Grid.Column="2" Text="{Binding Email}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForeground}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Role ComboBox -->
                                        <ComboBox Grid.Column="3"
                                                  ItemsSource="{x:Static vm:UsersManagementViewModel.Roles}"
                                                  SelectedValue="{Binding Role}"
                                                  SelectedValuePath="RoleDto"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Foreground="{DynamicResource PrimaryForeground}"
                                                  FontSize="12" Width="140"
                                                  HorizontalAlignment="Left"
                                                  SelectionChanged="OnRoleSelectionChanged"
                                                  Tag="{Binding}"/>

                                        <!-- Status pill -->
                                        <Border Grid.Column="4" CornerRadius="10" Padding="8,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A4CAF50"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Background" Value="#1AEF5350"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                <Setter Property="Foreground" Value="#EF5350"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Last login -->
                                        <TextBlock Grid.Column="5" Text="{Binding LastLoginDisplay}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForeground}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Lock/Unlock button -->
                                        <Button Grid.Column="6"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Padding="10,4" FontSize="11"
                                                Command="{Binding DataContext.ToggleLockCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                    <Setter Property="Foreground" Value="#EF5350"/>
                                                    <Setter Property="BorderBrush" Value="#EF5350"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Foreground" Value="#66BB6A"/>
                                                            <Setter Property="BorderBrush" Value="#66BB6A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon VerticalAlignment="Center"
                                                                         Width="13" Height="13"
                                                                         Margin="0,0,5,0">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="Lock"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                    <Setter Property="Kind" Value="LockOpenVariantOutline"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Заблокировать"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                    <Setter Property="Text" Value="Разблокировать"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
