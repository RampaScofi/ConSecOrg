<UserControl x:Class="ConSecOrg.Client.Views.Tasks.MyTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ConSecOrg.Client.ViewModels.Tasks"
             Background="{DynamicResource PrimaryBackground}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Tabs + Search -->
            <RowDefinition Height="Auto"/>   <!-- Column headers -->
            <RowDefinition Height="*"/>      <!-- Task rows -->
        </Grid.RowDefinitions>

        <!-- ═══════════ Header ═══════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Мои задачи" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Все задачи, назначенные на вас"
                               FontSize="12" Foreground="{DynamicResource SecondaryForeground}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Height="36" Padding="16,0"
                        Command="{Binding LoadCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Обновить"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════ Tabs + Search ═══════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SecondaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid MinHeight="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Tabs -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Mine" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BoardTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Mine">
                                        <Setter Property="Background" Value="{DynamicResource AccentAlphaBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCheck" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Задачи на мне" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Delegated" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BoardTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Delegated">
                                        <Setter Property="Background" Value="{DynamicResource AccentAlphaBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountArrowRight" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Порученные мной" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Private" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BoardTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Private">
                                        <Setter Property="Background" Value="{DynamicResource AccentAlphaBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Lock" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Приватные" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Starred">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BoardTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Starred">
                                        <Setter Property="Background" Value="{DynamicResource AccentAlphaBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Star" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"
                                                     Foreground="#FFC107"/>
                            <TextBlock Text="Избранные" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Search -->
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Поиск задач..."
                         materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontSize="12" Height="36"
                         VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════ Column Headers ═══════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>     <!-- Star -->
                    <ColumnDefinition Width="32"/>     <!-- Checkbox -->
                    <ColumnDefinition Width="*"/>      <!-- Title + path -->
                    <ColumnDefinition Width="120"/>    <!-- Date -->
                    <ColumnDefinition Width="130"/>    <!-- Deadline -->
                    <ColumnDefinition Width="130"/>    <!-- Priority -->
                    <ColumnDefinition Width="100"/>    <!-- Tags -->
                    <ColumnDefinition Width="36"/>     <!-- ⋮ -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="2" Text="НАЗВАНИЕ ЗАДАЧИ" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryForeground}" Opacity="0.6"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>

                <Button Grid.Column="3" Style="{StaticResource FlatIconButton}"
                        Command="{Binding SortByCommand}" CommandParameter="DueDate"
                        HorizontalAlignment="Left" Padding="4,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ДАТА" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForeground}" Opacity="0.6"
                                   VerticalAlignment="Center"/>
                        <materialDesign:PackIcon Kind="ChevronUp" Width="12" Height="12"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource SecondaryForeground}"
                                                 Margin="3,0,0,0"
                                                 Visibility="{Binding SortColumn, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource FlatIconButton}"
                        Command="{Binding SortByCommand}" CommandParameter="DueDate"
                        HorizontalAlignment="Left" Padding="4,2">
                    <TextBlock Text="ДЕДЛАЙН" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForeground}" Opacity="0.6"
                               VerticalAlignment="Center"/>
                </Button>

                <Button Grid.Column="5" Style="{StaticResource FlatIconButton}"
                        Command="{Binding SortByCommand}" CommandParameter="Priority"
                        HorizontalAlignment="Left" Padding="4,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="СТИКЕРЫ" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForeground}" Opacity="0.6"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="6" Text="ТЕГИ" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryForeground}" Opacity="0.6"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════ Task rows ═══════════ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredTasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MyTaskRow}">
                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="20,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>     <!-- Star -->
                                    <ColumnDefinition Width="32"/>     <!-- Checkbox -->
                                    <ColumnDefinition Width="*"/>      <!-- Title + path -->
                                    <ColumnDefinition Width="120"/>    <!-- Date created -->
                                    <ColumnDefinition Width="130"/>    <!-- Deadline -->
                                    <ColumnDefinition Width="130"/>    <!-- Priority sticker -->
                                    <ColumnDefinition Width="100"/>    <!-- Tags -->
                                    <ColumnDefinition Width="36"/>     <!-- ⋮ -->
                                </Grid.ColumnDefinitions>

                                <!-- ★ Star -->
                                <Button Grid.Column="0"
                                        Style="{StaticResource FlatIconButton}"
                                        Width="28" Height="28"
                                        Command="{Binding DataContext.ToggleStarCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Width="14" Height="14">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="StarOutline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStarred}" Value="True">
                                                        <Setter Property="Kind" Value="Star"/>
                                                        <Setter Property="Foreground" Value="#FFC107"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>

                                <!-- ○ Complete toggle -->
                                <Button Grid.Column="1"
                                        Style="{StaticResource FlatIconButton}"
                                        Width="28" Height="28"
                                        Command="{Binding DataContext.ToggleCompleteCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Отметить выполненной">
                                    <materialDesign:PackIcon Width="16" Height="16">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="CheckboxBlankCircleOutline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource BorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Kind" Value="CheckCircle"/>
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>

                                <!-- Title + path (click to open detail) -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource FlatIconButton}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,0"
                                        Command="{Binding DataContext.OpenTaskCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource PrimaryForeground}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForeground}"
                                                   Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Created date -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryForeground}"
                                           VerticalAlignment="Center"
                                           Opacity="0.7"/>

                                <!-- Deadline pill -->
                                <Border Grid.Column="4"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        CornerRadius="6" Padding="10,4"
                                        Background="{Binding DueDateBg, Converter={StaticResource HexColorToBrushConverter}}"
                                        Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarClock" Width="12" Height="12"
                                                                 VerticalAlignment="Center" Margin="0,0,5,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Foreground" Value="{Binding DueDateFg, Converter={StaticResource HexColorToBrushConverter}}"/>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding DueDateText}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding DueDateFg, Converter={StaticResource HexColorToBrushConverter}}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Priority sticker -->
                                <Border Grid.Column="5"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        CornerRadius="6" Padding="10,4"
                                        Background="{Binding PriorityBg, Converter={StaticResource HexColorToBrushConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Flag" Width="12" Height="12"
                                                                 VerticalAlignment="Center" Margin="0,0,5,0"
                                                                 Foreground="{Binding PriorityColor, Converter={StaticResource HexColorToBrushConverter}}"/>
                                        <TextBlock Text="{Binding PriorityText}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding PriorityColor, Converter={StaticResource HexColorToBrushConverter}}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Tags -->
                                <ItemsControl Grid.Column="6"
                                              ItemsSource="{Binding Tags}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AccentAlphaBrush}"
                                                    CornerRadius="6" Padding="6,2" Margin="0,0,3,2">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ⋮ Context menu -->
                                <Button Grid.Column="7"
                                        Style="{StaticResource FlatIconButton}"
                                        Width="28" Height="28"
                                        x:Name="rowDotsBtn"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Click="RowDotsButton_Click">
                                    <materialDesign:PackIcon Kind="DotsVertical" Width="14" Height="14"
                                                             Foreground="{DynamicResource SecondaryForeground}"/>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Открыть"
                                                      Command="{Binding Path=PlacementTarget.Tag.OpenTaskCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Отметить выполненной"
                                                      Command="{Binding Path=PlacementTarget.Tag.ToggleCompleteCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14" Foreground="#4CAF50"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Удалить"
                                                      Command="{Binding Path=PlacementTarget.Tag.DeleteTaskCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Foreground="#EF5350">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#EF5350"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
