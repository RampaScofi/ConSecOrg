<UserControl x:Class="ConSecOrg.Client.Views.Tasks.ChatPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ConSecOrg.Client.ViewModels.Tasks"
             Width="320">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ConSecOrg.Client;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource SecondaryBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0">
        <Border.Effect>
            <DropShadowEffect Direction="180" ShadowDepth="4" BlurRadius="12" Opacity="0.15" Color="#000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="14,12"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource PrimaryBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Chat" Width="16" Height="16"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ChatTitle}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource FlatIconButton}"
                            Width="28" Height="28"
                            Command="{Binding ToggleCommand}"
                            ToolTip="Закрыть">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14"
                                                 Foreground="{DynamicResource SecondaryForeground}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Messages list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Name="MessagesScroller">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="10,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                            <Grid Margin="0,4">
                                <!-- My message (right-aligned) -->
                                <Border HorizontalAlignment="Right" MaxWidth="220"
                                        CornerRadius="12,2,12,12" Padding="10,8"
                                        Background="{DynamicResource AccentBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" FontSize="12"
                                                   Foreground="White" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding TimeDisplay}" FontSize="10"
                                                   Foreground="#CCFFFFFF"
                                                   HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Other's message (left-aligned) -->
                                <StackPanel HorizontalAlignment="Left" MaxWidth="240"
                                            Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="28" Height="28" CornerRadius="14"
                                            Background="{DynamicResource AccentBrush}"
                                            Margin="0,0,6,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SenderLetter}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="2,12,12,12" Padding="10,8"
                                            Background="{DynamicResource PrimaryBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SenderUsername}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Text}" FontSize="12"
                                                       Foreground="{DynamicResource PrimaryForeground}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TimeDisplay}" FontSize="10"
                                                       Foreground="{DynamicResource SecondaryForeground}"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <materialDesign:PackIcon Kind="ChatOutline" Width="40" Height="40"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource SecondaryForeground}" Opacity="0.3"/>
                <TextBlock Text="Нет сообщений" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForeground}" Opacity="0.5"
                           Margin="0,10,0,4"/>
                <TextBlock Text="Начните общение с командой" FontSize="11"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryForeground}" Opacity="0.4"/>
            </StackPanel>

            <!-- Input row -->
            <Border Grid.Row="2" Padding="10,8"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource PrimaryBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Написать сообщение..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="{DynamicResource PrimaryForeground}"
                             FontSize="12" MinHeight="36" MaxHeight="80"
                             TextWrapping="Wrap" AcceptsReturn="False"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            Width="36" Height="36" Margin="6,0,0,0"
                            Command="{Binding SendCommand}"
                            ToolTip="Отправить (Enter)">
                        <materialDesign:PackIcon Kind="Send" Width="15" Height="15"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
