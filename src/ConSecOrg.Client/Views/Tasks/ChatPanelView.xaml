<UserControl x:Class="ConSecOrg.Client.Views.Tasks.ChatPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ConSecOrg.Client.ViewModels.Tasks"
             Width="320">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ConSecOrg.Client;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource SecondaryBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0">
        <Border.Effect>
            <DropShadowEffect Direction="180" ShadowDepth="4" BlurRadius="12" Opacity="0.15" Color="#000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="14,12"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource PrimaryBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Chat" Width="16" Height="16"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ChatTitle}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource FlatIconButton}"
                            Width="28" Height="28"
                            Command="{Binding ToggleCommand}"
                            ToolTip="Закрыть">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14"
                                                 Foreground="{DynamicResource SecondaryForeground}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Messages list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Name="MessagesScroller">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="10,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                            <Grid Margin="0,4">
                                <!-- My message (right-aligned) -->
                                <StackPanel HorizontalAlignment="Right" MaxWidth="230">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- Image attachment -->
                                    <Border CornerRadius="10,2,10,10" ClipToBounds="True"
                                            Margin="0,0,0,2" MaxWidth="220"
                                            Visibility="{Binding IsImageAttachment, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Image Source="{Binding AttachmentPath}"
                                               MaxHeight="180" Stretch="UniformToFill"
                                               Cursor="Hand">
                                            <Image.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding AttachmentPath}"/>
                                            </Image.InputBindings>
                                        </Image>
                                    </Border>
                                    <!-- File attachment -->
                                    <Button HorizontalAlignment="Right" Margin="0,0,0,2"
                                            Visibility="{Binding IsFileAttachment, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding AttachmentPath}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            materialDesign:ButtonAssist.CornerRadius="8"
                                            Height="32" Padding="8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileOutline" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding AttachmentFileName}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Text bubble -->
                                    <Border CornerRadius="12,2,12,12" Padding="10,8"
                                            Background="{DynamicResource AccentBrush}"
                                            Visibility="{Binding HasAttachment, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" FontSize="12"
                                                       Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TimeDisplay}" FontSize="10"
                                                       Foreground="#CCFFFFFF"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Time shown separately when there's an attachment -->
                                    <TextBlock Text="{Binding TimeDisplay}" FontSize="10"
                                               Foreground="{DynamicResource SecondaryForeground}"
                                               HorizontalAlignment="Right" Margin="0,2,0,0"
                                               Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- Other's message (left-aligned) -->
                                <StackPanel HorizontalAlignment="Left" MaxWidth="240"
                                            Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="28" Height="28" CornerRadius="14"
                                            Background="{DynamicResource AccentBrush}"
                                            Margin="0,0,6,0" VerticalAlignment="Top"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding SenderLetter}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasAvatar, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                            <Image Source="{Binding AvatarImage}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel>
                                        <!-- Image attachment -->
                                        <Border CornerRadius="2,10,10,10" ClipToBounds="True"
                                                Margin="0,0,0,2" MaxWidth="190"
                                                Visibility="{Binding IsImageAttachment, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Image Source="{Binding AttachmentPath}"
                                                   MaxHeight="150" Stretch="UniformToFill"
                                                   Cursor="Hand">
                                                <Image.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding AttachmentPath}"/>
                                                </Image.InputBindings>
                                            </Image>
                                        </Border>
                                        <!-- File attachment -->
                                        <Button Margin="0,0,0,2"
                                                Visibility="{Binding IsFileAttachment, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding AttachmentPath}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8"
                                                Height="32" Padding="8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileOutline" Width="14" Height="14" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding AttachmentFileName}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Text bubble -->
                                        <Border CornerRadius="2,12,12,12" Padding="10,8"
                                                Background="{DynamicResource PrimaryBackground}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding HasAttachment, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SenderUsername}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Text}" FontSize="12"
                                                           Foreground="{DynamicResource PrimaryForeground}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource SecondaryForeground}"
                                                           HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Time shown separately when there's an attachment -->
                                        <TextBlock Text="{Binding TimeDisplay}" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForeground}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <materialDesign:PackIcon Kind="ChatOutline" Width="40" Height="40"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource SecondaryForeground}" Opacity="0.3"/>
                <TextBlock Text="Нет сообщений" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForeground}" Opacity="0.5"
                           Margin="0,10,0,4"/>
                <TextBlock Text="Начните общение с командой" FontSize="11"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryForeground}" Opacity="0.4"/>
            </StackPanel>

            <!-- Input row -->
            <Border Grid.Row="2" Padding="10,8"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource PrimaryBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Attach file button -->
                    <Button Grid.Column="0"
                            Style="{StaticResource FlatIconButton}"
                            Width="32" Height="32" Margin="0,0,4,0"
                            Command="{Binding AttachFileCommand}"
                            ToolTip="Прикрепить файл">
                        <materialDesign:PackIcon Kind="Paperclip" Width="16" Height="16"
                                                 Foreground="{DynamicResource SecondaryForeground}"/>
                    </Button>

                    <TextBox Grid.Column="1"
                             Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Написать сообщение..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="{DynamicResource PrimaryForeground}"
                             FontSize="12" MinHeight="36" MaxHeight="80"
                             TextWrapping="Wrap" AcceptsReturn="False"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2"
                            Style="{StaticResource AppRaisedButton}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}"
                            Width="36" Height="36" Margin="6,0,0,0"
                            Command="{Binding SendCommand}"
                            ToolTip="Отправить (Enter)">
                        <materialDesign:PackIcon Kind="Send" Width="15" Height="15"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
