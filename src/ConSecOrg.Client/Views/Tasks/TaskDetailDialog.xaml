<Window x:Class="ConSecOrg.Client.Views.Tasks.TaskDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ConSecOrg.Client.ViewModels.Tasks"
        xmlns:svc="clr-namespace:ConSecOrg.Client.Services"
        Title="Задача"
        Width="580" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SecondaryBackground}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        TextElement.Foreground="{DynamicResource PrimaryForeground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════════════
                 РЕКУРСИВНЫЙ ШАБЛОН ПОДЗАДАЧИ (YouGile-style tree)
            ═══════════════════════════════════════════════════════ -->
            <DataTemplate x:Key="SubTaskTemplate" DataType="{x:Type svc:SubTaskItem}">
                <Grid Margin="0,1,0,1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Строка подзадачи ── -->
                    <Border Grid.Row="0" CornerRadius="6" Padding="2,2" Margin="0,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>  <!-- chevron expand -->
                                <ColumnDefinition Width="22"/>  <!-- circle checkbox -->
                                <ColumnDefinition Width="*"/>   <!-- title + inline edit -->
                                <ColumnDefinition Width="Auto"/><!-- progress / counter -->
                                <ColumnDefinition Width="22"/>  <!-- ⋮ menu -->
                            </Grid.ColumnDefinitions>

                            <!-- Chevron (expand/collapse) -->
                            <Button Grid.Column="0"
                                    Style="{StaticResource FlatIconButton}"
                                    Width="20" Height="24" Padding="0"
                                    Command="{Binding DataContext.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <materialDesign:PackIcon Width="11" Height="11"
                                                         Foreground="{DynamicResource SecondaryForeground}">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="ChevronRight"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Kind" Value="ChevronDown"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>

                            <!-- Кружочный чекбокс -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource FlatIconButton}"
                                    Width="22" Height="26" Padding="0"
                                    Command="{Binding DataContext.ToggleSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <materialDesign:PackIcon Width="15" Height="15">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="CheckboxBlankCircleOutline"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Kind" Value="CheckCircle"/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>

                            <!-- Inline-редактируемый заголовок -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,4,0">
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryForeground}"
                                         FontSize="13" Padding="2,4"
                                         MinHeight="26" VerticalContentAlignment="Center"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         LostFocus="SubTaskTitle_LostFocus">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding DataContext.SaveSubTaskTitleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <!-- Priority + due date badges -->
                                <WrapPanel Margin="0,2,0,0">
                                    <Border CornerRadius="4" Padding="5,1" Margin="0,0,5,1">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding PriorityBackground}"/>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Flag" Width="9" Height="9"
                                                                     Foreground="{Binding PriorityColor}"
                                                                     VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding PriorityText}" FontSize="9"
                                                       Foreground="{Binding PriorityColor}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="4" Padding="5,1" Margin="0,0,0,1"
                                            Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDueDatePast}" Value="True">
                                                        <Setter Property="Background" Value="#1AF44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd MMM}'}" FontSize="9">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDueDatePast}" Value="True">
                                                            <Setter Property="Foreground" Value="#F44336"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Прогресс-счётчик дочерних -->
                            <Border Grid.Column="3" CornerRadius="8"
                                    Background="{DynamicResource AccentAlphaBrush}"
                                    Padding="6,1" Margin="0,0,2,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding ChildProgressText}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <!-- ⋮ -->
                            <Button Grid.Column="4"
                                    Style="{StaticResource FlatIconButton}"
                                    Width="22" Height="26" Padding="0"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Click="SubDotsButton_Click">
                                <materialDesign:PackIcon Kind="DotsVertical" Width="12" Height="12"
                                                         Foreground="{DynamicResource SecondaryForeground}"/>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Редактировать"
                                                  Command="{Binding Path=PlacementTarget.Tag.EditSubTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Pencil" Width="13" Height="13"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Раскрыть/свернуть"
                                                  Command="{Binding Path=PlacementTarget.Tag.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="UnfoldMoreHorizontal" Width="13" Height="13"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Выполнена / Отменить"
                                                  Command="{Binding Path=PlacementTarget.Tag.ToggleSubTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="13" Height="13" Foreground="#4CAF50"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Удалить"
                                                  Command="{Binding Path=PlacementTarget.Tag.RemoveSubTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Foreground="#EF5350">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" Foreground="#EF5350"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── Раскрытая часть: ветка + дети + поле создания ── -->
                    <Grid Grid.Row="1" Margin="14,0,0,4"
                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>  <!-- branch line -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Вертикальная ветка -->
                        <Border Grid.Column="0" Width="1.5"
                                Background="{DynamicResource AccentBrush}" Opacity="0.5"
                                HorizontalAlignment="Center"/>

                        <!-- Контент ветки -->
                        <StackPanel Grid.Column="1">
                            <!-- Дочерние подзадачи (рекурсивно через тот же шаблон).
                                 Используется DynamicResource — StaticResource не умеет
                                 разрешать ссылку на самого себя на этапе парсинга XAML. -->
                            <ItemsControl ItemsSource="{Binding Children}"
                                          ItemTemplate="{DynamicResource SubTaskTemplate}"/>

                            <!-- + Создать подзадачу для ЭТОЙ ветки -->
                            <Grid Margin="6,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewChildTitle, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="+ Создать подзадачу"
                                         materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                         materialDesign:HintAssist.IsFloating="False"
                                         Foreground="{DynamicResource PrimaryForeground}"
                                         CaretBrush="{DynamicResource PrimaryForeground}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="12" Height="34" Padding="10,6"
                                         VerticalContentAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding DataContext.AddChildSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Style="{StaticResource FlatIconButton}"
                                        Command="{Binding DataContext.AddChildSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="34" Height="34" Margin="4,0,0,0">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                                             Foreground="{DynamicResource AccentBrush}"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18,24,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding ColumnPath}"
                           FontSize="11" Foreground="{DynamicResource SecondaryForeground}"
                           Margin="0,0,0,5"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForeground}"
                               TextWrapping="Wrap" LineHeight="28"/>
                    <Border Grid.Column="1" CornerRadius="6" Padding="10,4"
                            Margin="12,0,0,0" VerticalAlignment="Top"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Background><SolidColorBrush Color="#4CAF50" Opacity="0.15"/></Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="13" Height="13"
                                                     Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Выполнено" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,14,24,8">
            <StackPanel>

                <!-- Priority + Due date -->
                <WrapPanel Margin="0,0,0,14">
                    <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,6">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding PriorityBackground}"/>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Flag" Width="13" Height="13"
                                                     Foreground="{Binding PriorityColor}"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding PriorityText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding PriorityColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,6"
                            Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDueDatePast}" Value="True">
                                        <Setter Property="Background" Value="#1AF44336"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarCheck" Width="13" Height="13"
                                                     VerticalAlignment="Center" Margin="0,0,5,0">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDueDatePast}" Value="True">
                                                <Setter Property="Foreground" Value="#F44336"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDueDatePast}" Value="True">
                                                <Setter Property="Foreground" Value="#F44336"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Tags -->
                <StackPanel Margin="0,0,0,14"
                            Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="ТЕГИ" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForeground}"
                               Margin="0,0,0,6" Opacity="0.6"/>
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AccentAlphaBrush}"
                                        CornerRadius="12" Padding="10,4" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Description -->
                <StackPanel Margin="0,0,0,14"
                            Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="ОПИСАНИЕ" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForeground}"
                               Margin="0,0,0,8" Opacity="0.6"/>
                    <Border Background="{DynamicResource PrimaryBackground}"
                            CornerRadius="8" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding Description}" FontSize="13"
                                   TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                    </Border>
                </StackPanel>

                <!-- Empty description -->
                <Border Background="{DynamicResource PrimaryBackground}"
                        CornerRadius="8" Padding="14,10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasDescription, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                    <TextBlock Text="Описание не добавлено" FontSize="13" FontStyle="Italic"
                               Foreground="{DynamicResource SecondaryForeground}" Opacity="0.55"/>
                </Border>

                <!-- ── Subtasks ── -->
                <StackPanel Margin="0,0,0,8">

                    <!-- Section header -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListChecks" Width="14" Height="14"
                                                     Foreground="{DynamicResource SecondaryForeground}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Подзадачи" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource AccentAlphaBrush}"
                                    CornerRadius="8" Padding="7,2" Margin="8,0,0,0"
                                    Visibility="{Binding HasSubTasks, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding SubTaskProgress}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Subtask tree (рекурсивный шаблон из Window.Resources).
                         DynamicResource — для согласованности с дочерним вызовом внутри шаблона. -->
                    <ItemsControl ItemsSource="{Binding SubTasks}"
                                  ItemTemplate="{DynamicResource SubTaskTemplate}"/>

                    <!-- ОТКЛЮЧЕНО: старая нерекурсивная разметка (оставлена для безопасности) -->
                    <ItemsControl ItemsSource="{Binding SubTasks}"
                                  Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:SubTaskItem}">
                                <Grid Margin="0,0,0,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Vertical tree line (shown when expanded) -->
                                    <Border Grid.Row="1" Width="1"
                                            Background="{DynamicResource BorderBrush}"
                                            HorizontalAlignment="Left"
                                            Margin="15,0,0,4"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- ── Subtask row ── -->
                                    <Border Grid.Row="0" CornerRadius="6" Padding="4,3" Margin="0,1,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>  <!-- circle checkbox -->
                                                <ColumnDefinition Width="*"/>   <!-- title + badges -->
                                                <ColumnDefinition Width="Auto"/><!-- progress badge -->
                                                <ColumnDefinition Width="24"/>  <!-- dots menu -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Circle checkbox -->
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource FlatIconButton}"
                                                    Width="24" Height="28" Padding="0"
                                                    Command="{Binding DataContext.ToggleSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Width="16" Height="16">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="CheckboxBlankCircleOutline"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BorderBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Kind" Value="CheckCircle"/>
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>

                                            <!-- Title + priority + due date -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Priority + due date row -->
                                                <WrapPanel Margin="0,3,0,0">
                                                    <!-- Priority badge -->
                                                    <Border CornerRadius="4" Padding="5,2" Margin="0,0,5,2">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding PriorityBackground}"/>
                                                        </Border.Background>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Flag" Width="10" Height="10"
                                                                                     Foreground="{Binding PriorityColor}"
                                                                                     VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                            <TextBlock Text="{Binding PriorityText}" FontSize="10"
                                                                       Foreground="{Binding PriorityColor}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Due date badge -->
                                                    <Border CornerRadius="4" Padding="5,2" Margin="0,0,0,2"
                                                            Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDueDatePast}" Value="True">
                                                                        <Setter Property="Background" Value="#1AF44336"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="CalendarOutline" Width="10" Height="10"
                                                                                     VerticalAlignment="Center" Margin="0,0,3,0">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDueDatePast}" Value="True">
                                                                                <Setter Property="Foreground" Value="#F44336"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                            <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd MMM}'}"
                                                                       FontSize="10" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDueDatePast}" Value="True">
                                                                                <Setter Property="Foreground" Value="#F44336"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Progress badge (X/Y ˄) -->
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource FlatIconButton}"
                                                    Padding="5,2"
                                                    Command="{Binding DataContext.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ChildProgressText}"
                                                               FontSize="11" Foreground="{DynamicResource SecondaryForeground}"
                                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <materialDesign:PackIcon Width="12" Height="12"
                                                                             Foreground="{DynamicResource SecondaryForeground}">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="ChevronDown"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Kind" Value="ChevronUp"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </StackPanel>
                                            </Button>

                                            <!-- ⋮ menu -->
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource FlatIconButton}"
                                                    Width="24" Height="28" Padding="0"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="SubDotsButton_Click">
                                                <materialDesign:PackIcon Kind="DotsVertical" Width="13" Height="13"
                                                                         Foreground="{DynamicResource SecondaryForeground}"/>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Редактировать"
                                                                  Command="{Binding Path=PlacementTarget.Tag.EditSubTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Pencil" Width="13" Height="13"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Создать подзадачу"
                                                                  Command="{Binding Path=PlacementTarget.Tag.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Plus" Width="13" Height="13"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Выполнена / Отменить"
                                                                  Command="{Binding Path=PlacementTarget.Tag.ToggleSubTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="13" Height="13" Foreground="#4CAF50"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Удалить"
                                                                  Command="{Binding Path=PlacementTarget.Tag.RemoveSubTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Foreground="#EF5350">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" Foreground="#EF5350"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- ── Children (expanded) ── -->
                                    <StackPanel Grid.Row="1" Margin="24,0,0,4"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- Child subtask list -->
                                        <ItemsControl ItemsSource="{Binding Children}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type svc:SubTaskItem}">
                                                    <Border CornerRadius="6" Padding="4,2" Margin="0,1,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Circle checkbox -->
                                                            <Button Grid.Column="0"
                                                                    Style="{StaticResource FlatIconButton}"
                                                                    Width="24" Height="26" Padding="0"
                                                                    Command="{Binding DataContext.ToggleSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <materialDesign:PackIcon Width="14" Height="14">
                                                                    <materialDesign:PackIcon.Style>
                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                            <Setter Property="Kind" Value="CheckboxBlankCircleOutline"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource BorderBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter Property="Kind" Value="CheckCircle"/>
                                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialDesign:PackIcon.Style>
                                                                </materialDesign:PackIcon>
                                                            </Button>

                                                            <!-- Title + badges -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                                                                <TextBlock Text="{Binding Title}" FontSize="12">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <WrapPanel Margin="0,2,0,0">
                                                                    <Border CornerRadius="4" Padding="5,1" Margin="0,0,5,1">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{Binding PriorityBackground}"/>
                                                                        </Border.Background>
                                                                        <TextBlock Text="{Binding PriorityText}" FontSize="9"
                                                                                   Foreground="{Binding PriorityColor}"/>
                                                                    </Border>
                                                                    <Border CornerRadius="4" Padding="5,1" Margin="0,0,0,1"
                                                                            Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsDueDatePast}" Value="True">
                                                                                        <Setter Property="Background" Value="#1AF44336"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd MMM}'}"
                                                                                   FontSize="9">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsDueDatePast}" Value="True">
                                                                                            <Setter Property="Foreground" Value="#F44336"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </WrapPanel>
                                                            </StackPanel>

                                                            <!-- ⋮ menu for child -->
                                                            <Button Grid.Column="2"
                                                                    Style="{StaticResource FlatIconButton}"
                                                                    Width="22" Height="26" Padding="0"
                                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Click="SubDotsButton_Click">
                                                                <materialDesign:PackIcon Kind="DotsVertical" Width="12" Height="12"
                                                                                         Foreground="{DynamicResource SecondaryForeground}"/>
                                                                <Button.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Редактировать"
                                                                                  Command="{Binding Path=PlacementTarget.Tag.EditSubTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                            <MenuItem.Icon>
                                                                                <materialDesign:PackIcon Kind="Pencil" Width="13" Height="13"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="Выполнена / Отменить"
                                                                                  Command="{Binding Path=PlacementTarget.Tag.ToggleSubTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                            <MenuItem.Icon>
                                                                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="13" Height="13" Foreground="#4CAF50"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <Separator/>
                                                                        <MenuItem Header="Удалить"
                                                                                  Command="{Binding Path=PlacementTarget.Tag.RemoveSubTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                  Foreground="#EF5350">
                                                                            <MenuItem.Icon>
                                                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" Foreground="#EF5350"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- + Создать подзадачу inline input -->
                                        <Grid Margin="0,4,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding NewChildTitle, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Добавить подзадачу..."
                                                     materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                                     Foreground="{DynamicResource PrimaryForeground}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     FontSize="12" Height="32">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter"
                                                                Command="{Binding DataContext.AddChildSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource FlatIconButton}"
                                                    Command="{Binding DataContext.AddChildSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="32" Height="32" Margin="4,0,0,0">
                                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                                                         Foreground="{DynamicResource AccentBrush}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add top-level subtask -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewSubTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Добавить подзадачу..."
                                 materialDesign:HintAssist.Foreground="{DynamicResource SecondaryForeground}"
                                 Foreground="{DynamicResource PrimaryForeground}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="13" Height="36">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddSubTaskCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Style="{StaticResource FlatIconButton}"
                                Command="{Binding AddSubTaskCommand}"
                                Width="36" Height="36" Margin="6,0,0,0">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"
                                                     Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer ── -->
        <Border Grid.Row="2"
                Background="{DynamicResource PrimaryBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11"
                           Foreground="{DynamicResource SecondaryForeground}"
                           VerticalAlignment="Center" Opacity="0.6">
                    <TextBlock.Text>
                        <Binding Path="Task.CreatedAt" StringFormat="Создано: {0:dd.MM.yyyy HH:mm}" FallbackValue=""/>
                    </TextBlock.Text>
                </TextBlock>
                <Button Grid.Column="1"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource AppRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Height="36" Padding="20,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Редактировать"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Height="36" Padding="20,0"
                        Content="Закрыть"/>
            </Grid>
        </Border>
    </Grid>
</Window>
