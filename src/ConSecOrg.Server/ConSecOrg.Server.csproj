<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ConSecOrg.Application\ConSecOrg.Application.csproj" />
    <ProjectReference Include="..\ConSecOrg.Infrastructure\ConSecOrg.Infrastructure.csproj" />
    <ProjectReference Include="..\ConSecOrg.Shared\ConSecOrg.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>consecorg-server-dev</UserSecretsId>
    <ApplicationIcon>Resources\server.ico</ApplicationIcon>
    <AssemblyTitle>ConSecOrg Server</AssemblyTitle>
    <AssemblyDescription>Защищённый органайзер — серверная часть</AssemblyDescription>
    <Product>ConSecOrg Server</Product>
    <Company>СФУ ИКИТ</Company>
    <Copyright>© 2025 Максутов Р.Ф.</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Resources\server.ico" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
